          "stringUnit": {
            "state": "translated",
            "value": "TLS handshake failed"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS 握手失敗"
          }
        }
      }
    },
    "下载量": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載量"
          }
        }
      }
    },
    "不是 HTTP 应答": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not an HTTP answer"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不是 HTTP 應答"
          }
        }
      }
    },
    "丢包": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loss"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "丟包"
          }
        }
      }
    },
    "体检没有完成": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The checkup did not finish"
          }
        },
        "zh-Hant": {
          "stringUnit": {
