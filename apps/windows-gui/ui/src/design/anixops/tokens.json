{
  "$description": "AnixOps Design System tokens, v1.1.0. W3C Design Tokens (DTCG) format. color.light and color.dark hold the same keys; terminal holds the CLI/TUI palette; every other group is theme independent. Generate CSS with: python3 scripts/build-tokens.py",
  "color": {
    "brand": {
      "$type": "color",
      "$description": "Brand gradient end points. Brand moments only (logo tile, login, user home hero numbers). Never for controls or text.",
      "gradient-start": { "$value": "#0EA5E9", "$description": "1.0.0 used #38BDF8; deepened in 1.0.2 so the white glyph stayed at least 3:1 on the gradient. Since 1.1.0 the gradient is the glyph colour on slate-900 (6.44:1 here, 4.00:1 at the end)." },
      "gradient-end": { "$value": "#6366F1" },
      "purple": { "$value": "#8B5CF6", "$description": "Supporting colour from the mobile app. Graphics only." },
      "amber": { "$value": "#F59E0B", "$description": "Supporting colour from the mobile app. Graphics only." },
      "slate-900": { "$value": "#0F172A", "$description": "App icon backdrop." },
      "slate-800": { "$value": "#1E293B", "$description": "App icon backdrop." }
    },
    "light": {
      "$type": "color",
      "bg": { "$value": "#FBFBFD" },
      "bg-elevated": { "$value": "#FFFFFF" },
      "bg-grouped": { "$value": "#F5F5F7" },
      "fill-1": { "$value": "rgba(120, 120, 128, 0.08)" },
      "fill-2": { "$value": "rgba(120, 120, 128, 0.12)" },
      "fill-3": { "$value": "rgba(120, 120, 128, 0.16)" },
      "separator": { "$value": "rgba(60, 60, 67, 0.12)" },
      "separator-strong": { "$value": "rgba(60, 60, 67, 0.29)" },
      "material": { "$value": "rgba(251, 251, 253, 0.72)", "$description": "Frosted bars; opaque fallback is bg." },
      "material-sidebar": { "$value": "rgba(242, 242, 245, 0.78)" },
      "label-1": { "$value": "#1D1D1F" },
      "label-2": { "$value": "#6E6E73" },
      "label-3": { "$value": "#86868B", "$description": "Non-essential text only, 14px and up (3.6:1)." },
      "accent": { "$value": "#4F5BE8", "$description": "Text links, focus ring, selected state." },
      "accent-hover": { "$value": "#4350DD" },
      "accent-fill": { "$value": "#4F5BE8", "$description": "Filled control background (primary button)." },
      "accent-fill-hover": { "$value": "#4350DD" },
      "on-accent": { "$value": "#FFFFFF" },
      "accent-soft": { "$value": "rgba(79, 91, 232, 0.10)" },
      "success": { "$value": "#1A7F37", "$description": "Corrected from #1E8E3E (4.21:1 on white, fails AA)." },
      "success-soft": { "$value": "rgba(26, 127, 55, 0.10)" },
      "warning": { "$value": "#B25000" },
      "warning-soft": { "$value": "rgba(178, 80, 0, 0.10)" },
      "danger": { "$value": "#D70015" },
      "danger-fill": { "$value": "#D70015" },
      "danger-fill-hover": { "$value": "#B8000F" },
      "danger-soft": { "$value": "rgba(215, 0, 21, 0.08)" },
      "on-danger": { "$value": "#FFFFFF" },
      "info": { "$value": "#4F5BE8" },
      "chart-1": { "$value": "#4F5BE8" },
      "chart-2": { "$value": "#0891B2" },
      "chart-3": { "$value": "#8B5CF6" },
      "chart-4": { "$value": "#DB2777" },
      "chart-5": { "$value": "#EA580C" },
      "chart-6": { "$value": "#A16207" },
      "chart-7": { "$value": "#16A34A" },
      "chart-8": { "$value": "#8E8E93" },
      "shadow-color": { "$value": "rgba(0, 0, 0, 0.06)" },
      "highlight": { "$value": "rgba(255, 255, 255, 0)", "$description": "1px top light edge; used in dark only." }
    },
    "dark": {
      "$type": "color",
      "bg": { "$value": "#000000" },
      "bg-elevated": { "$value": "#1C1C1E" },
      "bg-grouped": { "$value": "#111113" },
      "fill-1": { "$value": "rgba(120, 120, 128, 0.16)" },
      "fill-2": { "$value": "rgba(120, 120, 128, 0.24)" },
      "fill-3": { "$value": "rgba(120, 120, 128, 0.32)" },
      "separator": { "$value": "rgba(84, 84, 88, 0.48)" },
      "separator-strong": { "$value": "rgba(84, 84, 88, 0.80)" },
      "material": { "$value": "rgba(0, 0, 0, 0.68)" },
      "material-sidebar": { "$value": "rgba(28, 28, 30, 0.72)" },
      "label-1": { "$value": "#F5F5F7" },
      "label-2": { "$value": "#A1A1A6" },
      "label-3": { "$value": "#8E8E93" },
      "accent": { "$value": "#818CF8", "$description": "Text links, focus ring, selected state." },
      "accent-hover": { "$value": "#949EFA" },
      "accent-fill": { "$value": "#5B63E6", "$description": "White text on #818CF8 is only 2.98:1, so filled controls use a deeper indigo." },
      "accent-fill-hover": { "$value": "#5058DC" },
      "on-accent": { "$value": "#FFFFFF" },
      "accent-soft": { "$value": "rgba(129, 140, 248, 0.18)" },
      "success": { "$value": "#30D158" },
      "success-soft": { "$value": "rgba(48, 209, 88, 0.16)" },
      "warning": { "$value": "#FF9F0A" },
      "warning-soft": { "$value": "rgba(255, 159, 10, 0.16)" },
      "danger": { "$value": "#FF453A" },
      "danger-fill": { "$value": "#E0242F", "$description": "White text on #FF453A is only 3.41:1." },
      "danger-fill-hover": { "$value": "#C8102E" },
      "danger-soft": { "$value": "rgba(255, 69, 58, 0.16)" },
      "on-danger": { "$value": "#FFFFFF" },
      "info": { "$value": "#818CF8" },
      "chart-1": { "$value": "#818CF8" },
      "chart-2": { "$value": "#22D3EE" },
      "chart-3": { "$value": "#A78BFA" },
      "chart-4": { "$value": "#F472B6" },
      "chart-5": { "$value": "#FB923C" },
      "chart-6": { "$value": "#FACC15" },
      "chart-7": { "$value": "#4ADE80" },
      "chart-8": { "$value": "#8E8E93" },
      "shadow-color": { "$value": "rgba(0, 0, 0, 0.40)" },
      "highlight": { "$value": "rgba(255, 255, 255, 0.06)" }
    }
  },
  "terminal": {
    "$description": "CLI and TUI palette. light/dark are truecolor values for light and dark terminal backgrounds (lipgloss AdaptiveColor style); ansi256-* are the nearest xterm-256 colours (computed, redmean distance); ansi16 is the basic colour index, which the user's terminal theme remaps. Never rely on colour alone; honour NO_COLOR.",
    "accent":      { "light": { "$type": "color", "$value": "#4F5BE8" }, "dark": { "$type": "color", "$value": "#818CF8" }, "ansi256-light": { "$type": "number", "$value": 62 },  "ansi256-dark": { "$type": "number", "$value": 105 }, "ansi16": { "$type": "number", "$value": 4 } },
    "success":     { "light": { "$type": "color", "$value": "#1A7F37" }, "dark": { "$type": "color", "$value": "#30D158" }, "ansi256-light": { "$type": "number", "$value": 29 },  "ansi256-dark": { "$type": "number", "$value": 41 },  "ansi16": { "$type": "number", "$value": 2 } },
    "warning":     { "light": { "$type": "color", "$value": "#B25000" }, "dark": { "$type": "color", "$value": "#FF9F0A" }, "ansi256-light": { "$type": "number", "$value": 130 }, "ansi256-dark": { "$type": "number", "$value": 214 }, "ansi16": { "$type": "number", "$value": 3 } },
    "danger":      { "light": { "$type": "color", "$value": "#D70015" }, "dark": { "$type": "color", "$value": "#FF453A" }, "ansi256-light": { "$type": "number", "$value": 160 }, "ansi256-dark": { "$type": "number", "$value": 203 }, "ansi16": { "$type": "number", "$value": 1 } },
    "muted":       { "light": { "$type": "color", "$value": "#6E6E73" }, "dark": { "$type": "color", "$value": "#8E8E93" }, "ansi256-light": { "$type": "number", "$value": 242 }, "ansi256-dark": { "$type": "number", "$value": 246 }, "ansi16": { "$type": "number", "$value": 8 } },
    "brand-start": { "light": { "$type": "color", "$value": "#0EA5E9" }, "dark": { "$type": "color", "$value": "#0EA5E9" }, "ansi256-light": { "$type": "number", "$value": 38 },  "ansi256-dark": { "$type": "number", "$value": 38 },  "ansi16": { "$type": "number", "$value": 6 } },
    "brand-end":   { "light": { "$type": "color", "$value": "#6366F1" }, "dark": { "$type": "color", "$value": "#6366F1" }, "ansi256-light": { "$type": "number", "$value": 63 },  "ansi256-dark": { "$type": "number", "$value": 63 },  "ansi16": { "$type": "number", "$value": 5 } }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["-apple-system", "BlinkMacSystemFont", "Inter", "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", "system-ui", "sans-serif"] },
      "mono": { "$value": ["ui-monospace", "SF Mono", "JetBrains Mono", "Menlo", "Consolas", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    }
  },
  "type": {
    "$type": "typography",
    "$description": "7-step scale. On screens below md (834px) display drops to 34px and title-1 to 28px.",
    "display": { "$value": { "fontSize": "48px", "lineHeight": 1.08, "fontWeight": 700, "letterSpacing": "-0.015em" } },
    "title-1": { "$value": { "fontSize": "32px", "lineHeight": 1.125, "fontWeight": 700, "letterSpacing": "-0.01em" } },
    "title-2": { "$value": { "fontSize": "24px", "lineHeight": 1.17, "fontWeight": 600, "letterSpacing": "-0.005em" } },
    "title-3": { "$value": { "fontSize": "19px", "lineHeight": 1.26, "fontWeight": 600, "letterSpacing": "0" } },
    "body": { "$value": { "fontSize": "15px", "lineHeight": 1.47, "fontWeight": 400, "letterSpacing": "0" }, "$description": "Chinese text uses line-height 1.6." },
    "callout": { "$value": { "fontSize": "13px", "lineHeight": 1.38, "fontWeight": 400, "letterSpacing": "0" } },
    "caption": { "$value": { "fontSize": "12px", "lineHeight": 1.33, "fontWeight": 500, "letterSpacing": "0" } }
  },
  "space": {
    "$type": "dimension",
    "0-5": { "$value": "2px" }, "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" },
    "4": { "$value": "16px" }, "5": { "$value": "20px" }, "6": { "$value": "24px" }, "8": { "$value": "32px" },
    "10": { "$value": "40px" }, "12": { "$value": "48px" }, "16": { "$value": "64px" }, "20": { "$value": "80px" }
  },
  "size": {
    "$type": "dimension",
    "control-lg": { "$value": "44px" }, "control-md": { "$value": "36px" }, "control-sm": { "$value": "28px" },
    "content-user": { "$value": "980px" }, "content-admin": { "$value": "1280px" }, "content-wide": { "$value": "1440px" }, "content-read": { "$value": "692px" }
  },
  "radius": {
    "$type": "dimension",
    "xs": { "$value": "6px" }, "sm": { "$value": "10px" }, "md": { "$value": "14px" }, "lg": { "$value": "20px" }, "pill": { "$value": "980px" }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Values reference the theme's shadow-color; dark mode adds a 1px highlight edge instead of stronger shadows.",
    "1": { "$value": "0 1px 2px var(--shadow-color), 0 1px 1px var(--shadow-color)" },
    "2": { "$value": "0 4px 16px var(--shadow-color)" },
    "3": { "$value": "0 24px 64px var(--shadow-color), 0 0 0 1px var(--highlight)" }
  },
  "motion": {
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.25, 0.1, 0.25, 1] },
      "emphasized": { "$value": [0.2, 0.8, 0.2, 1] },
      "exit": { "$value": [0.4, 0, 1, 1] }
    },
    "duration": {
      "$type": "duration",
      "micro": { "$value": "120ms" }, "toggle": { "$value": "200ms" }, "overlay": { "$value": "280ms" }, "page": { "$value": "240ms" }
    }
  },
  "z": {
    "$type": "number",
    "base": { "$value": 0 }, "sticky": { "$value": 10 }, "dropdown": { "$value": 100 }, "drawer": { "$value": 200 },
    "modal": { "$value": 300 }, "toast": { "$value": 400 }, "tooltip": { "$value": 500 }
  },
  "breakpoint": {
    "$type": "dimension",
    "$description": "Media queries cannot read custom properties; these are emitted as comments and used literally.",
    "sm": { "$value": "640px" }, "md": { "$value": "834px" }, "lg": { "$value": "1068px" }, "xl": { "$value": "1440px" }
  }
}
