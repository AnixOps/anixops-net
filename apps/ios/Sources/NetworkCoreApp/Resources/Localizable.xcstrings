            "value": "比對請求"
          }
        }
      }
    },
    "目标 URL": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Target URL"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目標 URL"
          }
        }
      }
    },
    "转到": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send To"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉到"
          }
        }
      }
    },
    "正则匹配时目标原样使用，可以用 $1 引用第一个括号。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a regex match the target is used as written; $1 refers to the first group."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正規比對時目標原樣使用，可以用 $1 引用第一個括號。"
          }
        }
      }
    },
    "URL 剩下的部分接在目标后面。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rest of the URL is appended to the target."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "URL 剩下的部分接在目標後面。"
          }
        }
      }
    },
    "原请求的查询参数接在目标后面。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original request's query parameters are appended to the target."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原請求的查詢參數接在目標後面。"
          }
        }
      }
    },
    "编辑映射": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit Mapping"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯對應"
          }
        }
      }
    },
    "状态码": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status code"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "狀態碼"
          }
        }
      }
    },
    "响应头": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Response headers"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回應標頭"
          }
        }
      }
    },
    "响应头每行一个，写“名称: 值”。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One response header per line, as “Name: value”."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回應標頭每行一個，寫「名稱: 值」。"
          }
        }
      }
    },
    "改为文本": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change to Text"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改為文字"
          }
        }
      }
    },
    "最大 256 KB。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At most 256 KB."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最大 256 KB。"
          }
        }
      }
    },
    "这个 URL，查询参数任意。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This URL, with any query parameters."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個 URL，查詢參數任意。"
          }
        }
      }
    },
    "以这个 URL 开头的所有请求。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every request starting with this URL."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以這個 URL 開頭的所有請求。"
          }
        }
      }
    },
    "匹配整个 URL 的正则，例如 ^https://api\\.example\\.com/v1/.*。主机名用 \\. 写出时会自动对它开启解密。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A regex matching the whole URL, e.g. ^https://api\\.example\\.com/v1/.*. Decryption is turned on automatically for a host name written with \\."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "比對整個 URL 的正規表示式，例如 ^https://api\\.example\\.com/v1/.*。主機名稱用 \\. 寫出時會自動對它開啟解密。"
          }
        }
      }
    },
    "证书可能未加入钥匙串，或尚未设为“始终信任”。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The certificate may not be in the keychain, or not yet set to “Always Trust”."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "憑證可能未加入鑰匙圈，或尚未設為「永遠信任」。"
          }
        }
      }
    },
    "从网址导入": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import from URL"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從網址匯入"
          }
        }
      }
    },
    "正在下载…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloading…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在下載…"
          }
        }
      }
    },
    "从网址导入插件": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import a Plugin from a URL"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從網址匯入外掛"
          }
        }
      }
    },
    "只支持 https 地址。插件里的脚本不会自动运行，需要逐个允许。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only https addresses are supported. Scripts in a plugin do not run automatically and must be allowed one by one."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只支援 https 位址。外掛裡的腳本不會自動執行，需要逐一允許。"
          }
        }
      }
    },
    "撤销": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoke"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撤銷"
          }
        }
      }
    },
    "允许运行这个脚本？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow this script to run?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許執行這個腳本？"
          }
        }
      }
    },
    "下载并允许": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download and Allow"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載並允許"
          }
        }
      }
    },
    "左滑撤销。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe left to revoke."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "左滑撤銷。"
          }
        }
      }
    },
    "右键撤销。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right-click to revoke."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按右鍵撤銷。"
          }
        }
      }
    },
    "允许": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許"
          }
        }
      }
    },
    "不会运行：脚本地址不是 https": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Will not run: the script address is not https"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會執行：腳本位址不是 https"
          }
        }
      }
    },
    "插件数据": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugin data"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "外掛資料"
          }
        }
      }
    },
    "请输入 https 开头的插件地址": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a plugin address starting with https"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入 https 開頭的外掛位址"
          }
        }
      }
    },
    "插件不是 UTF-8 文本": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plugin is not UTF-8 text"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "外掛不是 UTF-8 文字"
          }
        }
      }
    },
    "脚本地址不是 https，无法下载": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The script address is not https, so it cannot be downloaded"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "腳本位址不是 https，無法下載"
          }
        }
      }
    },
    "脚本超过 4 MB": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The script is over 4 MB"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "腳本超過 4 MB"
          }
        }
      }
    },
    "下载到的内容不是脚本文本": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What was downloaded is not script text"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載到的內容不是腳本文字"
          }
        }
      }
    },
    "已允许的脚本合计超过 8 MB，请先撤销一些脚本或停用插件": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed scripts exceed 8 MB in total. Revoke some scripts or turn off plugins first"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已允許的腳本合計超過 8 MB，請先撤銷一些腳本或停用外掛"
          }
        }
      }
    },
    "按订阅规则和策略组分流；订阅无规则时按下方分流规则。切换立即生效，已有连接重新建立。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Routes by the subscription's rules and policy groups, or by the routing rules below when it has none. Switching takes effect at once and open connections reconnect."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按訂閱規則和策略組分流；訂閱無規則時按下方分流規則。切換立即生效，已有連線重新建立。"
          }
        }
      }
    },
    "重定向": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Redirects"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新導向"
          }
        }
      }
    },
    "添加重定向": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Redirect"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增重新導向"
          }
        }
      }
    },
    "命中的 TCP 连接和 UDP 流改发到新地址，App 看到的仍是原地址。从上到下第一条命中的生效；域名只能匹配 TCP（按 TLS 名称或 HTTP Host）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matching TCP connections and UDP flows are sent to the new address while the app still sees the original one. The first match from the top applies; domains match TCP only (by TLS name or HTTP Host)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "符合的 TCP 連線和 UDP 流改發到新位址，App 看到的仍是原位址。從上到下第一條符合的生效；網域只能比對 TCP（按 TLS 名稱或 HTTP Host）。"
          }
        }
      }
    },
    "原地址": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original address"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原位址"
          }
        }
      }
    },
    "端口（可选）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Port (optional)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接埠（選填）"
          }
        }
      }
    },
    "原地址可写 IP、网段（203.0.113.0/24）或域名（含子域名），也可以直接写一条规则，例如 DOMAIN,login.example.com。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original address can be an IP, a network (203.0.113.0/24) or a domain (with its subdomains), or a rule written out, e.g. DOMAIN,login.example.com."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原位址可寫 IP、網段（203.0.113.0/24）或網域（含子網域），也可以直接寫一條規則，例如 DOMAIN,login.example.com。"
          }
        }
      }
    },
    "新地址": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New address"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新位址"
          }
        }
      }
    },
    "改发到": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send To"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改發到"
          }
        }
      }
    },
    "IP 或域名，可带 :端口；不写端口沿用原端口。IPv6 带端口写 [地址]:端口。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An IP or domain, optionally with :port; without a port the original port is kept. Write IPv6 with a port as [address]:port."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "IP 或網域，可帶 :連接埠；不寫連接埠沿用原連接埠。IPv6 帶連接埠寫 [位址]:連接埠。"
          }
        }
      }
    },
    "编辑重定向": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit Redirect"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯重新導向"
          }
        }
      }
    },
    "无法保存重定向": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save redirects"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存重新導向"
          }
        }
      }
    },
    "抓到的请求体不完整，未带上；可在下方补全。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The captured request body is incomplete and was left out; complete it below if needed."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擷取的請求內文不完整，未帶上；可在下方補全。"
          }
        }
      }
    },
    "请求头": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request headers"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求標頭"
          }
        }
      }
    },
    "每行一个，写“名称: 值”。Host、Content-Length 由系统填写。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One per line, as “Name: value”. Host and Content-Length are filled in by the system."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一個，寫「名稱: 值」。Host、Content-Length 由系統填寫。"
          }
        }
      }
    },
    "重放请求": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replay Request"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重送請求"
          }
        }
      }
    },
    "发送": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送"
          }
        }
      }
    },
    "连接中时这次请求也会出现在抓包里。重定向不会自动跟随。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While connected, this request also shows up in the capture. Redirects are not followed."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線中時這次請求也會出現在擷取裡。重新導向不會自動跟隨。"
          }
        }
      }
    },
    "导入订阅或节点后，可在此选择规则、全局或直连模式。规则模式按自定义规则分流；带规则和策略组的订阅按订阅规则分流。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a subscription or nodes are imported, choose rule, global or direct mode here. Rule mode routes by custom rules; subscriptions with rules and policy groups route by their own rules."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入訂閱或節點後，可在此選擇規則、全域或直連模式。規則模式按自訂規則分流；帶規則和策略組的訂閱按訂閱規則分流。"
          }
        }
      }
    },
    "单个节点没有节点列表，无法按规则分流。导入订阅或多个节点后可用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A single node has no node list and cannot be routed by rules. Available after a subscription or several nodes are imported"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單個節點沒有節點列表，無法按規則分流。匯入訂閱或多個節點後可用"
          }
        }
      }
    },
    "保存 QUIC 设置到 VPN 配置失败": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save the QUIC setting to the VPN configuration"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存 QUIC 設定到 VPN 設定失敗"
          }
        }
      }
    },
    "无法保存本地规则": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save local rules"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存本機規則"
          }
        }
      }
    },
    "保存本地规则到 VPN 配置失败": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save local rules to the VPN configuration"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存本機規則到 VPN 設定失敗"
          }
        }
      }
    },
    "保存重定向到 VPN 配置失败": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save redirects to the VPN configuration"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存重新導向到 VPN 設定失敗"
          }
        }
      }
    },
    "请填写要匹配的 URL": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the URL to match"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請填寫要比對的 URL"
          }
        }
      }
    },
    "URL 应以 http:// 或 https:// 开头并带主机名": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The URL should start with http:// or https:// and have a host name"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "URL 應以 http:// 或 https:// 開頭並帶主機名稱"
          }
        }
      }
    },
    "正则表达式无效": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The regular expression is invalid"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正規表示式無效"
          }
        }
      }
    },
    "状态码应为 100–599": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The status code should be 100–599"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "狀態碼應為 100–599"
          }
        }
      }
    },
    "响应头每行写“名称: 值”，值里不能有 |": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write each response header as “Name: value” on its own line; values cannot contain |"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回應標頭每行寫「名稱: 值」，值裡不能有 |"
          }
        }
      }
    },
    "响应体不能超过 256 KB": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The response body cannot exceed 256 KB"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回應內文不能超過 256 KB"
          }
        }
      }
    },
    "目标应为 http:// 或 https:// 开头的完整 URL": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The target should be a full URL starting with http:// or https://"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目標應為 http:// 或 https:// 開頭的完整 URL"
          }
        }
      }
    },
    "请求方法只能包含字母，例如 GET、POST。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request method can contain only letters, e.g. GET or POST."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求方法只能包含字母，例如 GET、POST。"
          }
        }
      }
    },
    "请填写 http:// 或 https:// 开头的完整 URL。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a full URL starting with http:// or https://."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請填寫 http:// 或 https:// 開頭的完整 URL。"
          }
        }
      }
    },
    "请求体不能超过 1 MB。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request body cannot exceed 1 MB."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求內文不能超過 1 MB。"
          }
        }
      }
    },
    "服务器没有返回 HTTP 响应。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server did not return an HTTP response."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器沒有回傳 HTTP 回應。"
          }
        }
      }
    },
    "原地址应为 IP、网段、域名，或以 DOMAIN、IP-CIDR、AND 等开头的规则": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original address should be an IP, a network, a domain, or a rule starting with DOMAIN, IP-CIDR, AND or similar"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原位址應為 IP、網段、網域，或以 DOMAIN、IP-CIDR、AND 等開頭的規則"
          }
        }
      }
    },
    "端口应为 1–65535，或范围（如 7000-7100）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The port should be 1–65535, or a range such as 7000-7100"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接埠應為 1–65535，或範圍（如 7000-7100）"
          }
        }
      }
    },
    "新地址应为 IP 或域名，可带 :端口；只改端口写 :端口": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new address should be an IP or domain, optionally with :port; to change only the port, write :port"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新位址應為 IP 或網域，可帶 :連接埠；只改連接埠寫 :連接埠"
          }
        }
      }
    },
    "原地址、端口和协议至少填一项": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill in at least one of original address, port and protocol"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原位址、連接埠和協定至少填一項"
          }
