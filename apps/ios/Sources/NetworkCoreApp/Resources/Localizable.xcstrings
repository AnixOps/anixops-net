          }
        }
      }
    },
    "清除这些记录": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear These Records"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除這些記錄"
          }
        }
      }
    },
    "解密失败": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decryption Failed"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解密失敗"
          }
        }
      }
    },
    "根据本次连接以来的解密结果自动标出，只记录域名、次数和原因，断开后清空。排除后连接原样转发。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marked automatically from decryption results since this connection; only domains, counts and reasons are kept, cleared on disconnect. Excluded domains pass through untouched."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據本次連線以來的解密結果自動標出，只記錄網域、次數和原因，中斷後清空。排除後連線原樣轉送。"
          }
        }
      }
    },
    "停用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停用"
          }
        }
      }
    },
    "启用": {
      "localizations": {
        "en": {
