          "stringUnit": {
            "state": "translated",
            "value": "Import Plugin"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入外掛"
          }
        }
      }
    },
    "导入新节点会替换当前节点。多节点、订阅和策略组会在内核支持后开放。": {
      "localizations": {
        "en": {
          "stringUnit": {
