    "已保存": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存"
          }
        }
      }
    },
    "没有错误": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No errors"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有錯誤"
          }
        }
      }
    },
    "一行一条，写法同 Surge / Loon：类型,值,策略[,no-resolve]。策略写 DIRECT、REJECT，其他名字都当作代理。以 # 开头的整条规则表示停用，其余注释保存时不保留。连接中保存会直接在隧道里换上新规则，已有连接不断开；新增规则列表 URL 时会重新连接。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One rule a line, written as in Surge / Loon: type,value,policy[,no-resolve]. DIRECT and REJECT are kept; any other policy name means the proxy. A whole rule after # is switched off; other comments are not kept. Saving while connected swaps the rules in the running tunnel without dropping connections; adding a rule list URL reconnects."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一行一條，寫法同 Surge / Loon：類型,值,策略[,no-resolve]。策略寫 DIRECT、REJECT，其他名稱都當作代理。以 # 開頭的整條規則表示停用，其餘註解儲存時不保留。連線中儲存會直接在隧道裡換上新規則，現有連線不中斷；新增規則列表 URL 時會重新連線。"
          }
        }
      }
    },
    "第 %lld 行": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Line %lld"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %lld 行"
          }
        }
      }
    },
    "%lld 处错误，改好后才能保存": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld errors; fix them to save"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 處錯誤，改好後才能儲存"
          }
        }
      }
    },
    "不支持的规则类型 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsupported rule type %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不支援的規則類型 %@"
          }
        }
      }
    },
    "缺少规则的值": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rule has no value"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少規則的值"
          }
        }
      }
    },
    "值的写法不对，内核不会接受": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The value is not valid; the engine would refuse it"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "值的寫法不對，核心不會接受"
          }
        }
      }
    },
    "FINAL 由预设或订阅决定，这里不能写": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FINAL comes from the preset or the subscription and cannot be written here"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "FINAL 由預設或訂閱決定，這裡不能寫"
          }
        }
      }
    },
    "最多 %lld 条规则": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At most %lld rules"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 %lld 條規則"
          }
        }
      }
    },
    "仪表盘": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dashboard"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儀表板"
          }
        }
      }
    },
    "打开仪表盘": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Dashboard"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟儀表板"
          }
        }
      }
