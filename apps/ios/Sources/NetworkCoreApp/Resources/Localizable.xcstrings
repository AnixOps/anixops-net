      }
    },
    "在插件和映射里修改。这里的排除同样作用于它们。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change these in plugins and mappings. Exclusions here apply to them too."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在外掛和對應裡修改。這裡的排除同樣作用於它們。"
          }
        }
      }
    },
    "哪些 HTTPS 能解密": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which HTTPS Can Be Decrypted"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "哪些 HTTPS 能解密"
          }
        }
      }
    },
    "域名在列表中（或在插件、映射中）、未被排除，且已信任 HTTPS 解密证书。加入后新建的连接才会解密。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A domain in this list (or in a plugin or mapping) that is not excluded, once the HTTPS decryption certificate is trusted. Only connections made after it is added are decrypted."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網域在列表中（或在外掛、對應中）、未被排除，且已信任 HTTPS 解密憑證。加入後新建的連線才會解密。"
          }
        }
      }
    },
    "只解密 443 端口的 HTTPS；列表中域名的 HTTP/3（QUIC）连接会被拒绝，App 改用 HTTPS。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only HTTPS on port 443 is decrypted; HTTP/3 (QUIC) connections to listed domains are refused and the app falls back to HTTPS."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只解密 443 連接埠的 HTTPS；列表中網域的 HTTP/3（QUIC）連線會被拒絕，App 改用 HTTPS。"
          }
        }
      }
    },
    "不能解密：固定了证书的 App（常见于银行、支付和系统服务），以及只有 IP 地址、没有域名的连接。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not decryptable: apps that pin their certificate (common for banking, payments and system services), and connections with only an IP address and no domain."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不能解密：固定了憑證的 App（常見於銀行、支付和系統服務），以及只有 IP 位址、沒有網域的連線。"
          }
        }
      }
    },
    "已停用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已停用"
          }
        }
      }
    },
    "已解密 %lld 个连接，%lld 个域名失败": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld connections decrypted, %2$lld domains failed"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已解密 %1$lld 個連線，%2$lld 個網域失敗"
          }
        }
      }
    },
    "已解密 %lld 个连接": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld connections decrypted"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已解密 %lld 個連線"
          }
        }
      }
    },
    "App 拒绝了证书：可能固定了证书，或没有信任根证书": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app refused the certificate: it may pin its certificate, or the root is not trusted"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 拒絕了憑證：可能固定了憑證，或沒有信任根憑證"
          }
        }
      }
    },
    "App 在握手时断开：常见于证书固定": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app closed the connection during the handshake, which is common with certificate pinning"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 在交握時中斷：常見於憑證固定"
          }
        }
      }
    },
    "与 App 的 TLS 握手失败": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TLS handshake with the app failed"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與 App 的 TLS 交握失敗"
          }
        }
      }
    },
    "App 没有在限定时间内完成握手": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app did not finish the handshake in time"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 沒有在限定時間內完成交握"
          }
        }
      }
    },
    "源站 TLS 握手失败，例如它的证书与域名不符": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The origin's TLS handshake failed, for example its certificate does not match the domain"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "源站 TLS 交握失敗，例如它的憑證與網域不符"
          }
        }
      }
    },
    "连不上源站，或源站没有及时响应": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The origin could not be reached, or did not answer in time"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連不上源站，或源站沒有及時回應"
          }
        }
      }
    },
    "失败 %lld 次 · 解密 %lld 次": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld failed · %2$lld decrypted"
          }
        },
