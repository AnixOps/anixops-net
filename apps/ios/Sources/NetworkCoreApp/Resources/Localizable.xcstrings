          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出這條請求"
          }
        }
      }
    },
    "Cookie、Authorization 和名字含 token、password、session 等的请求头、参数与字段会换成 <redacted>。": {
      "localizations": {
        "en": {
          "stringUnit": {
