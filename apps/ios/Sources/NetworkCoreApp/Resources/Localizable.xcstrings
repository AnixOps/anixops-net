          }
        }
      }
    },
    "出口为“经过节点”时才用到订阅、节点和规则；直连时它们原样保留。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriptions, nodes and rules are used only when the exit is “Through a node”; with Direct they are kept as they are."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出口為「經過節點」時才用到訂閱、節點和規則；直連時它們原樣保留。"
          }
        }
      }
    },
    "解密域名": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decrypted domains"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解密網域"
          }
        }
      }
