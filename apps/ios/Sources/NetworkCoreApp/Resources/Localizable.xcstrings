          }
        }
      }
    },
    "已开启": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已開啟"
          }
        }
      }
    },
    "未开启": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未開啟"
          }
        }
      }
    },
    "复制命令": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy Command"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拷貝指令"
          }
        }
      }
    },
    "网关模式": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gateway Mode"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "閘道模式"
          }
        }
      }
    },
    "网关模式要用 VPN 接管流量，“仅系统代理”下不能开启。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gateway mode needs the VPN to take traffic; it is not available with System Proxy Only."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "閘道模式要用 VPN 接管流量，「僅系統代理」下不能開啟。"
          }
        }
      }
    },
    "开启后，局域网设备将路由器和 DNS 设为上方地址，其流量经这台 Mac 按规则转发。连接时开启 IPv4 转发，断开时关闭；仅支持 IPv4。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, local network devices that set their router and DNS to the addresses above send traffic through this Mac by the rules. IPv4 forwarding is turned on when connecting and off when disconnecting; IPv4 only."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，區域網路裝置將路由器和 DNS 設為上方位址，其流量經這台 Mac 按規則轉送。連線時開啟 IPv4 轉送，中斷時關閉；僅支援 IPv4。"
          }
        }
      }
    },
    "未命中规则的域名由默认服务器解析。长按服务器可设为默认、加入默认竞速（最多 4 个同时查询）或设为备用。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Domains no rule picks go to the default servers. Long-press a server to set it as default, add it to the default race (up to 4 queried at once) or set it as fallback."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未命中規則的網域由預設伺服器解析。長按伺服器可設為預設、加入預設競速（最多 4 個同時查詢）或設為備用。"
          }
        }
      }
    },
    "地址可写 1.1.1.1、udp://、tcp://、tls://（DoT）、https://（DoH）、quic://（DoQ）或 system（本机网络的 DNS）。IP 地址形式的 DoT/DoH/DoQ 需填写证书上的 TLS 名称。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter 1.1.1.1, udp://, tcp://, tls:// (DoT), https:// (DoH), quic:// (DoQ) or system (the local network's DNS). DoT/DoH/DoQ by IP address needs the TLS name on the certificate."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位址可寫 1.1.1.1、udp://、tcp://、tls://（DoT）、https://（DoH）、quic://（DoQ）或 system（本機網路的 DNS）。IP 位址形式的 DoT/DoH/DoQ 需填寫憑證上的 TLS 名稱。"
          }
        }
      }
    },
    "地址应为 IP、system，或 udp://、tcp://、tls://、https://、quic:// 开头": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address must be an IP or system, or start with udp://, tcp://, tls://, https:// or quic://"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位址應為 IP、system，或 udp://、tcp://、tls://、https://、quic:// 開頭"
          }
        }
      }
    },
