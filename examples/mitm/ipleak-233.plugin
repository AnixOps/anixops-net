#!name = ipleak 233 测试（脚本）
#!desc = 用 MITM 脚本把 ipleak.net 显示的 IPv4 地址全部改成 233.333.333.333。
#!author = AnixOps Net
#!homepage = https://github.com/AnixOps/anixops-net/tree/main/examples/mitm

[Script]
http-response ^https?:\/\/([^\/]+\.)?ipleak\.net\/ script-path=https://raw.githubusercontent.com/AnixOps/anixops-net/main/examples/mitm/ipleak-233.js, requires-body=true, timeout=10, tag=ipleak-233

[MITM]
hostname = ipleak.net, *.ipleak.net
