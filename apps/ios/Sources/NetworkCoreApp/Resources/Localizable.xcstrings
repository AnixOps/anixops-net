      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop Decrypting"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不再解密"
          }
        }
      }
