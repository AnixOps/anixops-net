      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5 connection attempts in a row failed, so automatic reconnecting has stopped. Open the app to retry or switch to another node."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
