          }
        }
      }
    },
    "再测一次": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run again"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
