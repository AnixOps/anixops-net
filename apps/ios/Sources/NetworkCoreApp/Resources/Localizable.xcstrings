          }
        }
      }
    },
    "打开仪表盘": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Dashboard"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟儀表板"
          }
        }
      }
    },
    "我的规则": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My Rules"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我的規則"
          }
        }
      }
    },
    "排在订阅规则前面，从上到下匹配。连接中保存会直接换上新规则，已有连接不断开。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matched top to bottom before the subscription's rules. Saving while connected swaps them in without dropping connections."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排在訂閱規則前面，從上到下比對。連線中儲存會直接換上新規則，現有連線不中斷。"
          }
        }
      }
    },
    "规则模式下排在预设前面，从上到下匹配。连接中保存会直接换上新规则，已有连接不断开。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In rule mode, matched top to bottom before the preset. Saving while connected swaps them in without dropping connections."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "規則模式下排在預設前面，從上到下比對。連線中儲存會直接換上新規則，現有連線不中斷。"
          }
        }
      }
    },
    "自动重连": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnect automatically"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動重新連線"
          }
        }
      }
    },
    "保持不变": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave as is"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持不變"
          }
        }
      }
    },
    "隧道意外退出后由系统在数秒内重新连接。手动断开时一并关闭，下次连接再开启。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system reconnects within seconds after an unexpected tunnel exit. Disconnecting manually turns this off until the next connection."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隧道意外結束後由系統在數秒內重新連線。手動斷開時一併關閉，下次連線再開啟。"
          }
        }
      }
    },
    "Wi-Fi 名称": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi name"
          }
