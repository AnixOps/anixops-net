    },
    "AnixOps Studio 出品": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Made by AnixOps Studio"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AnixOps Studio 出品"
          }
        }
      }
    },
    "色条是每个成员最近一次测得的延迟：绿色低于 120 ms，琥珀色低于 250 ms，橙色更慢，灰色没有数据。自动选择和故障转移的组由内核按延迟和可用性挑选节点。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The strip shows each member's last measured delay: green under 120 ms, amber under 250 ms, orange slower, gray no data. Auto-select and fallback groups are picked by the engine by delay and availability."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "色條是每個成員最近一次測得的延遲：綠色低於 120 ms，琥珀色低於 250 ms，橙色更慢，灰色沒有資料。自動選擇和容錯移轉的組由核心按延遲和可用性挑選節點。"
          }
        }
      }
    },
    "切换节点": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch node"
          }
