# Local editor state
.idea/
.vscode/
*.swp
*.swo

# Local environment
.env
.env.*
!.env.example

# Build outputs must be generated by GitHub Actions, not committed from local runs.
dist/
build/
out/
target/
coverage/
*.log
node_modules/

# OS metadata
.DS_Store
Thumbs.db

# XcodeGen output is generated in GitHub Actions only and never committed
apps/ios/*.xcodeproj/
apps/ios/Generated/
# Third-party notices are generated by .github/actions/third-party-notices in release builds only
apps/ios/Sources/NetworkCoreApp/Resources/THIRD_PARTY_NOTICES.txt

# Native Android app: Gradle state, local SDK path, and the Rust library CI's cargo-ndk step puts in jniLibs
apps/android-native/.gradle/
apps/android-native/.kotlin/
apps/android-native/local.properties
apps/android-native/app/src/main/jniLibs/

# Native Windows app: .NET build output
apps/windows-native/**/bin/
apps/windows-native/**/obj/

# Python bytecode
__pycache__/
*.pyc
