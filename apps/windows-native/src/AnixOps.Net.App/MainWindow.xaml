<Window
    x:Class="AnixOps.Net.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The title bar is the app's own: the system draws only the caption buttons over it. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <StackPanel
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Border
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    Background="{ThemeResource BrandPrimaryBrush}"
                    CornerRadius="4" />
                <TextBlock
                    x:Name="AppName"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock
                    x:Name="AppStage"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <!-- Whether the core service answers. One dot per state, so each keeps its theme colour. -->
                <Grid
                    Width="8"
                    Height="8"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">
                    <Ellipse x:Name="CoreConnecting" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Ellipse
                        x:Name="CoreConnected"
                        Fill="{ThemeResource SystemFillColorSuccessBrush}"
                        Visibility="Collapsed" />
                    <Ellipse
                        x:Name="CoreUnavailable"
                        Fill="{ThemeResource SystemFillColorCautionBrush}"
                        Visibility="Collapsed" />
                </Grid>
                <TextBlock
                    x:Name="CoreStatus"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="Core.Status"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            AutomationProperties.AutomationId="Navigation"
            CompactModeThresholdWidth="560"
            ExpandedModeThresholdWidth="900"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="220"
            PaneDisplayMode="Auto"
            SelectionChanged="OnSelectionChanged">
            <Frame x:Name="PageFrame" />
        </NavigationView>
    </Grid>
</Window>
