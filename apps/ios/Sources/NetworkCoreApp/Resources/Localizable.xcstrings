          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接埠被佔用"
          }
        }
      }
    },
    "Prometheus 指标": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prometheus Metrics"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Prometheus 指標"
          }
        }
      }
    },
    "正在启动…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在啟動…"
          }
        }
      }
    },
    "指标": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Metrics"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指標"
          }
        }
      }
    },
    "只监听本机回环地址，连接时包含内核的连接、流量和节点健康指标，与 Windows、Linux 客户端相同。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listens on the loopback address only. While connected it includes the engine's connection, traffic and node health metrics, the same as the Windows and Linux clients."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只監聽本機迴路位址，連線時包含核心的連線、流量和節點健康指標，與 Windows、Linux 用戶端相同。"
          }
        }
      }
    },
    "响应": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Response"
          }
        },
        "zh-Hant": {
