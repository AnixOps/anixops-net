    "未添加": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未新增"
          }
        }
      }
