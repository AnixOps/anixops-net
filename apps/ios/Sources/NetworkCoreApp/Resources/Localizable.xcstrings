    "来自插件和映射": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From Plugins and Mappings"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自外掛和對應"
          }
