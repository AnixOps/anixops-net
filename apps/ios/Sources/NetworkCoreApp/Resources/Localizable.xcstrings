          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空閒延遲"
          }
        }
      }
    },
    "经该节点访问 1.1.1.1 和 www.gstatic.com 各 5 次，测握手、请求延迟、抖动和丢包。仅在点击开始时运行，不经过隧道。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reaches 1.1.1.1 and www.gstatic.com through this node 5 times each to measure handshake, request latency, jitter and loss. Runs only on start, outside the tunnel."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "經該節點存取 1.1.1.1 和 www.gstatic.com 各 5 次，測握手、請求延遲、抖動和封包遺失。僅在點選開始時執行，不經過隧道。"
          }
        }
      }
    },
    "经该节点访问 1.1.1.1 和 www.gstatic.com 测延迟，并从 speed.cloudflare.com 下载约 8 秒测速度（最多 200 MB，会消耗节点流量）。仅在点击开始时运行，不经过隧道。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measures latency to 1.1.1.1 and www.gstatic.com through this node, then downloads from speed.cloudflare.com for about 8 seconds (at most 200 MB, counted against the node's traffic). Runs only on start, outside the tunnel."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "經該節點存取 1.1.1.1 和 www.gstatic.com 測延遲，並從 speed.cloudflare.com 下載約 8 秒測速度（最多 200 MB，會消耗節點流量）。僅在點選開始時執行，不經過隧道。"
          }
        }
      }
    },
