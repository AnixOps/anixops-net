            "state": "translated",
            "value": "缺少規則的值"
          }
        }
      }
    },
    "值的写法不对，内核不会接受": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The value is not valid; the engine would refuse it"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "值的寫法不對，核心不會接受"
          }
        }
      }
    },
    "FINAL 由预设或订阅决定，这里不能写": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FINAL comes from the preset or the subscription and cannot be written here"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "FINAL 由預設或訂閱決定，這裡不能寫"
          }
        }
      }
    },
