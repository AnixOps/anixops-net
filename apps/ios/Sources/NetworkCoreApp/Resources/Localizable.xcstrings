            "state": "translated",
            "value": "最多 %lld 條規則"
          }
        }
      }
    },
    "仪表盘": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dashboard"
          }
        },
        "zh-Hant": {
