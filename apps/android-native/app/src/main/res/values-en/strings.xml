    <string name="dns_system">System DNS</string>
    <string name="dns_encrypted">Encrypted DNS</string>
    <string name="dns_split">Split by region</string>
    <string name="dns_custom">Custom DNS</string>
    <string name="dns_system_hint">The embedded engine resolves domains that IP rules need with the system DNS; connections through a node have the node server resolve the domain.</string>
    <string name="dns_encrypted_hint">Every name is resolved with Cloudflare DNS over HTTPS through the node, so the local network cannot see the queries.</string>
    <string name="dns_split_hint">Mainland names go directly to AliDNS over HTTPS and the rest to Cloudflare through the node, so mainland sites get nearby addresses.</string>
    <string name="dns_custom_hint">Uses the servers, per-domain servers and hosts below.</string>
    <string name="dns_fake_ip_hint">Apps get an address in 198.18.0.0/15 at once when they look up a name; when they connect, the name is restored, matched against the rules and resolved by the node. LAN, time, STUN and push names still get real addresses.</string>
    <string name="dns_custom_note">One per line; lines starting with # are comments. Without servers the engine asks its default server over TCP through the node.</string>
    <string name="dns_servers">Servers</string>
    <string name="dns_servers_hint">name = address; the first is the default server. The address is an IP, tcp://, tls:// or https://; add direct to reach it directly, otherwise it goes through the node.</string>
    <string name="dns_rules">Per-domain servers</string>
    <string name="dns_rules_hint">type,domain,server name, matched top to bottom. The type is DOMAIN, DOMAIN-SUFFIX, DOMAIN-KEYWORD or RULE-SET (a rule set the routing mode has).</string>
    <string name="dns_hosts_hint">domain = address, up to 8 addresses; *.domain matches its subdomains.</string>
    <string name="block_quic">Block QUIC</string>
    <string name="block_quic_hint">Refuses QUIC (HTTP/3) on UDP port 443 so browsers and apps use TCP instead, where MITM plugins and domain rules apply.</string>
