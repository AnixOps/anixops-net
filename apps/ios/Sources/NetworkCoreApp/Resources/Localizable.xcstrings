            "state": "translated",
            "value": "失敗 %1$lld 次 · 解密 %2$lld 次"
          }
        }
      }
    },
    "* 匹配任意字符（包括点），? 匹配一个字符。排除的域名永不解密。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "* matches any characters (dots included) and ? one character. Excluded domains are never decrypted."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "* 符合任意字元（包括點），? 符合一個字元。排除的網域永不解密。"
          }
        }
      }
    },
    "编辑域名": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit Domain"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯網域"
          }
        }
      }
    },
    "列表里已有这个域名": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This domain is already in the list"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "列表裡已有這個網域"
          }
        }
      }
    },
    "已排除，不解密": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluded, not decrypted"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已排除，不解密"
          }
        }
      }
    },
    "这是加密的 TLS 数据。这个域名在解密列表里被排除，不会解密。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is encrypted TLS data. The domain is excluded in the decryption list, so it is not decrypted."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是加密的 TLS 資料。這個網域在解密列表裡被排除，不會解密。"
          }
        }
      }
    },
    "导入时跳过的规则": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules Skipped on Import"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入時略過的規則"
          }
        }
      }
    },
    "这些规则在导入订阅时没有导入，不会生效。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These rules were not imported with the subscription and have no effect."
          }
        },
        "zh-Hant": {
