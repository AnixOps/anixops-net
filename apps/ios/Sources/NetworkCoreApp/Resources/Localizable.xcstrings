      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See each connection's target, matched rule and route"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看每個連線的目標、命中規則和線路"
          }
        }
      }
    },
    "连接后可用。只保存在内存里，断开隧道即清空。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available while connected. Kept in memory only and cleared when the tunnel disconnects."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線後可用。只儲存在記憶體裡，斷開隧道即清空。"
          }
        }
      }
    },
    "规则与 DNS": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules and DNS"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "規則與 DNS"
          }
        }
      }
    },
    "规则集": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rule sets"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "規則集"
          }
        }
      }
    },
    "导入带规则和策略组的订阅（Clash、Surge、Loon 配置）后，可以按订阅规则分流和切换策略组。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import a subscription with rules and policy groups (Clash, Surge or Loon profiles) to route by its rules and switch policy groups."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入帶規則和策略組的訂閱（Clash、Surge、Loon 設定）後，可以按訂閱規則分流和切換策略組。"
          }
        }
      }
    },
    "编辑…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
