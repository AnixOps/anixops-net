        }
      }
    },
    "这条消息不是 Protobuf，见十六进制。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This message is not Protobuf. See Hex."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這條訊息不是 Protobuf，見十六進位。"
          }
        }
      }
    },
    "…（只解析了开头部分）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "… (only the start was decoded)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "…（只解析了開頭部分）"
          }
        }
      }
    },
    "导出正文": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export Body"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出正文"
          }
        }
      }
    },
    "用其他应用打开": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in Another App"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用其他應用程式開啟"
          }
        }
      }
    },
    "图片太大（%lld × %lld），不在这里画出；可以导出后用其他应用查看。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image is too large to draw here (%lld × %lld). Export it to view it in another app."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片太大（%lld × %lld），不在這裡畫出；可以匯出後用其他應用程式檢視。"
          }
        }
      }
    },
    "由旧版本导入：更新后证书固定才会生效": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported by an earlier version: update it to apply certificate pins"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由舊版本匯入：更新後憑證固定才會生效"
          }
        }
      }
    },
    "由旧版本导入：重新导入后证书固定才会生效": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported by an earlier version: import it again to apply certificate pins"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由舊版本匯入：重新匯入後憑證固定才會生效"
          }
        }
      }
    },
    "无法把新根证书记录到 VPN 配置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not record the new root certificate in the VPN configuration"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法把新根憑證記錄到 VPN 設定"
          }
        }
      }
    },
    "HTTPS 解密证书已更换，隧道仍在用旧证书签发。请断开再连接。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The HTTPS decryption certificate changed, but the tunnel still issues certificates from the old one. Disconnect and connect again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS 解密憑證已更換，通道仍在用舊憑證簽發。請斷開再連線。"
          }
        }
      }
    },
    "连接已断开，抓包随之停止。这台设备上无法保存会话，断开前抓到的内容未保存。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnected; capture stopped. Sessions cannot be saved on this device; captured content was not saved."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線已斷開，擷取隨之停止。這台裝置上無法儲存工作階段，斷開前擷取的內容未儲存。"
          }
        }
      }
    },
    "连接已断开，抓包停止。抓到的内容已尝试加密保存，可在 ⋯ › 已保存的会话 确认。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnected; capture stopped. Saving the captured content encrypted was attempted; check ⋯ › Saved Sessions."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線已斷開，擷取停止。已嘗試加密儲存擷取的內容，可在 ⋯ › 已儲存的工作階段 確認。"
          }
        }
      }
    },
    "会话用仅保存在这台 Mac 上的密钥加密，仅系统级隧道扩展可读取，保留 7 天后自动删除。打开会话会替换当前抓包内容并停止抓包。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessions are encrypted with a key kept only on this Mac, readable only by the system tunnel extension, and deleted after 7 days. Opening a session replaces the current capture and stops capturing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作階段用僅保存在這台 Mac 上的金鑰加密，僅系統級的通道延伸功能可讀取，保留 7 天後自動刪除。開啟工作階段會取代目前的擷取內容並停止擷取。"
          }
        }
      }
    },
    "这台 Mac 上无法保存会话（隧道扩展读不到会话密钥）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessions cannot be saved on this Mac (the tunnel extension cannot read the session key)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 上無法儲存工作階段（通道延伸功能讀不到工作階段金鑰）。"
          }
        }
      }
    },
    "已连接的隧道自动重新连接并改用新证书。系统要求输入登录密码，撤销这台 Mac 对旧证书的信任；新证书需重新加入钥匙串并信任，其他设备上的旧证书需分别删除。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A connected tunnel reconnects automatically with the new certificate. macOS asks for the login password to stop trusting the old certificate on this Mac; the new one must be added to the keychain and trusted again, and the old one removed from other devices."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已連線的通道自動重新連線並改用新憑證。系統要求輸入登入密碼，撤銷這台 Mac 對舊憑證的信任；新憑證需重新加入鑰匙圈並信任，其他裝置上的舊憑證需分別刪除。"
          }
        }
      }
    },
    "证书和私钥只保存在本机钥匙串；重新生成或更换根证书后，已连接的隧道自动重新连接，这台 Mac 撤销对旧证书的信任，其他设备需改装新证书。若“信任证书”未成功，在“钥匙串访问”中将该证书设为“始终信任”；Firefox 使用独立证书列表，需另行导入。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The certificate and its private key stay in this Mac's keychain; after regenerating or replacing the root, a connected tunnel reconnects automatically, this Mac stops trusting the old certificate, and other devices need the new one installed. If Trust Certificate did not work, set the certificate to Always Trust in Keychain Access; Firefox keeps its own certificate list and needs a separate import."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "憑證和私鑰只保存在本機鑰匙圈；重新產生或更換根憑證後，已連線的通道自動重新連線，這台 Mac 撤銷對舊憑證的信任，其他裝置需改裝新憑證。若「信任憑證」未成功，在「鑰匙圈存取」中將該憑證設為「永遠信任」；Firefox 使用獨立憑證列表，需另行匯入。"
          }
        }
      }
    },
    "已取消。旧证书“%@”仍受这台 Mac 信任：在“钥匙串访问”中找到它，删除它或把信任改回“使用系统默认”。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelled. This Mac still trusts the old certificate “%@”: find it in Keychain Access and delete it, or set its trust back to Use System Defaults."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消。舊憑證「%@」仍受這台 Mac 信任：在「鑰匙圈存取」中找到它，刪除它或把信任改回「使用系統預設值」。"
          }
        }
      }
    },
    "无法撤销对旧证书“%@”的信任（%@）。请在“钥匙串访问”中删除这张证书。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not stop trusting the old certificate “%@” (%@). Delete it in Keychain Access."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法撤銷對舊憑證「%@」的信任（%@）。請在「鑰匙圈存取」中刪除這張憑證。"
          }
        }
      }
    },
    "旧证书“%@”仍受这台 Mac 信任，信任设置不在当前用户名下，App 无权更改。请在“钥匙串访问”的“系统”钥匙串中删除它。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac still trusts the old certificate “%@” through a setting outside the current user account that the app cannot change. Delete it from the System keychain in Keychain Access."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舊憑證「%@」仍受這台 Mac 信任，信任設定不在目前使用者名下，App 無權更改。請在「鑰匙圈存取」的「系統」鑰匙圈中刪除它。"
          }
        }
      }
    },
    "已撤销对旧证书“%@”的信任，但没能把它从钥匙串删除（%@），可以在“钥匙串访问”中手动删除。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac no longer trusts the old certificate “%@”, but it could not be removed from the keychain (%@); delete it manually in Keychain Access."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已撤銷對舊憑證「%@」的信任，但沒能把它從鑰匙圈刪除（%@），可以在「鑰匙圈存取」中手動刪除。"
          }
        }
      }
    },
    "粘贴 PEM 格式的 CA 证书和它的私钥。私钥需为 P-256（prime256v1）密钥，只保存在本机钥匙串；替换后已连接的隧道自动重新连接，这台 Mac 撤销对旧证书的信任（需要登录密码）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the CA certificate and its private key in PEM format. The key must be a P-256 (prime256v1) key and stays in this Mac's keychain; after the switch a connected tunnel reconnects on its own and this Mac stops trusting the old certificate (the login password is needed)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上 PEM 格式的 CA 憑證和它的私鑰。私鑰需為 P-256（prime256v1）金鑰，只保存在本機鑰匙圈；替換後已連線的通道自動重新連線，這台 Mac 撤銷對舊憑證的信任（需要登入密碼）。"
          }
        }
      }
    },
    "已连接的隧道会自动重新连接并改用新证书。新证书需要重新安装并信任，之后请删除旧描述文件。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A connected tunnel reconnects on its own and uses the new certificate. Install and trust the new one, then delete the old profile."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已連線的通道會自動重新連線並改用新憑證。新憑證需要重新安裝並信任，之後請刪除舊描述檔。"
          }
        }
      }
    },
    "重新生成后，已连接的隧道自动重新连接并改用新证书；新证书需重新安装并信任。请在 设置 > 通用 > VPN与设备管理 中删除旧描述文件。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After regenerating, a connected tunnel reconnects automatically with the new root; install and trust the new certificate. Delete the old profile in Settings > General > VPN & Device Management."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新產生後，已連線的通道自動重新連線並改用新憑證；新憑證需重新安裝並信任。請在 設定 > 一般 > VPN與裝置管理 中刪除舊描述檔。"
          }
        }
      }
    },
    "插件只解密自己 [MITM] 列出的主机，解密域名和映射另行生效；明文 HTTP 全部交给插件处理，仅支持 HTTP/1.1。使用前需先连接 VPN。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugins decrypt only the hosts under their own [MITM]; decrypted domains and mappings apply separately. Plain HTTP always goes through plugins, HTTP/1.1 only; connect the VPN first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "外掛只解密自己 [MITM] 列出的主機，解密網域和對應另行生效；明文 HTTP 全部交給外掛處理，僅支援 HTTP/1.1。使用前需先連線 VPN。"
          }
        }
      }
    },
    "网络扩展保存的配置副本已过期。请打开 App 重新连接。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The network extension's copy of the configuration is out of date. Open the app and connect again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網路擴充功能保存的設定副本已過期。請開啟 App 重新連線。"
          }
        }
      }
    },
    "网络扩展保存的配置副本已过期，自动重连没有成功。请重新连接。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The network extension's copy of the configuration is out of date, and reconnecting automatically did not work. Connect again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網路擴充功能保存的設定副本已過期，自動重新連線沒有成功。請重新連線。"
          }
        }
      }
    },
    "按网络选择": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By network"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按網路選擇"
          }
        }
      }
    },
    "由旧版本导入：更新后按网络选择的策略组才会生效": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported by an earlier version: update it to apply its by-network groups"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由舊版本匯入：更新後按網路選擇的策略組才會生效"
          }
        }
      }
    },
    "由旧版本导入：重新导入后按网络选择的策略组才会生效": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported by an earlier version: import it again to apply its by-network groups"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由舊版本匯入：重新匯入後按網路選擇的策略組才會生效"
          }
        }
      }
    },
    "规则未生效：节点、规则和已启用的插件合计超出隧道配置上限，隧道仅使用所选节点。请减少规则或停用部分插件后重新连接。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules are not in effect: nodes, rules and enabled plugins together exceed the tunnel configuration limit, and the tunnel uses only the selected node. Remove some rules or turn off some plugins, then reconnect."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "規則未生效：節點、規則和已啟用的外掛合計超出隧道設定上限，隧道僅使用所選節點。請減少規則或停用部分外掛後重新連線。"
          }
        }
      }
    },
    "规则没有生效：内核没有接受分流设置，隧道只用选中的节点。开发者诊断的扩展事件里有原因。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules are not in effect: the engine did not accept the routing settings, so the tunnel uses only the selected node. The extension events in developer diagnostics give the reason."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "規則沒有生效：核心沒有接受分流設定，隧道只用選中的節點。開發者診斷的擴充事件裡有原因。"
          }
        }
      }
    },
    "规则集超过 %lld 个，以下规则集和用到它们的规则没有生效：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More than %lld rule sets: these rule sets, and the rules that use them, are not in effect: %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "規則集超過 %lld 個，以下規則集和用到它們的規則沒有生效：%@"
          }
        }
      }
    },
    "HTTPS 解密未生效：已启用的插件和调试映射合计超出隧道配置上限。请停用部分插件或缩短映射内容后重新连接。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS decryption is not active: enabled plugins and debug mappings together exceed the tunnel configuration limit. Turn off some plugins or shorten mapping bodies, then reconnect."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS 解密未生效：已啟用的外掛和除錯對應合計超出隧道設定上限。請停用部分外掛或縮短對應內文後重新連線。"
          }
        }
      }
    },
    "有 %lld 条重定向内核无法使用，不会生效。请编辑或删除标出的条目。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld redirects cannot be used by the engine and are not in effect. Edit or delete the marked entries."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 條重新導向核心無法使用，不會生效。請編輯或刪除標出的項目。"
          }
        }
      }
    },
    "无效，不会生效": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid, not in effect"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無效，不會生效"
          }
        }
      }
    },
    "映射合计超过 4 MB（响应体按 Base64 计算）。请删除或缩小部分 Map Local 响应体。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappings exceed 4 MB in total (response bodies count in Base64). Delete or shrink some Map Local response bodies."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對應合計超過 4 MB（回應內文按 Base64 計算）。請刪除或縮小部分 Map Local 回應內文。"
          }
        }
      }
    },
    "已启用的插件和调试映射合计超过 64 KB，超出隧道配置上限：连接时 HTTPS 解密将关闭，插件和映射均不生效。请停用部分插件或减小映射响应体。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabled plugins and debug mappings exceed 64 KB, the tunnel configuration limit: HTTPS decryption is turned off on connect and neither plugins nor mappings apply. Disable some plugins or shrink mapping response bodies."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已啟用的外掛和除錯對應合計超過 64 KB，超出通道設定上限：連線時 HTTPS 解密將關閉，外掛和對應均不生效。請停用部分外掛或縮小對應回應內文。"
          }
        }
      }
    },
    "映射和已启用的插件合计超过 8 MB。请减少映射响应体或停用一些插件。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappings and enabled plugins exceed 8 MB in total. Shrink mapping response bodies or turn off some plugins."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對應和已啟用的外掛合計超過 8 MB。請減少對應回應內文或停用一些外掛。"
          }
        }
      }
    },
    "启用的插件和调试映射合计超过 8 MB，请先停用一些插件或减少映射响应体": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabled plugins and debug mappings exceed 8 MB in total. Turn some plugins off or shrink mapping response bodies first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用的外掛和除錯對應合計超過 8 MB，請先停用一些外掛或減少對應回應內文"
          }
        }
      }
    },
    "DNS 规则合计最多 %lld 个域名、后缀和关键词。较长的列表请改用 RULE-SET 或 GEOSITE 规则集。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS rules can list at most %lld domains, suffixes and keywords in total. Use a RULE-SET or GEOSITE rule set for longer lists."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS 規則合計最多 %lld 個網域、後綴和關鍵字。較長的列表請改用 RULE-SET 或 GEOSITE 規則集。"
          }
        }
      }
    },
    "已用 %lld / %lld 个域名、后缀和关键词": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld of %lld domains, suffixes and keywords used"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已用 %lld / %lld 個網域、後綴和關鍵字"
          }
        }
      }
    },
    "超出上限，排在后面的规则不会生效。请删除一些规则，较长的列表改用 RULE-SET 或 GEOSITE 规则集。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over the limit: the last rules are not in effect. Delete some rules, and use a RULE-SET or GEOSITE rule set for longer lists."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "超出上限，排在後面的規則不會生效。請刪除一些規則，較長的列表改用 RULE-SET 或 GEOSITE 規則集。"
          }
        }
      }
    },
    "启用的插件合计超过 8 MB，请先停用一些插件": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabled plugins exceed 8 MB in total. Turn some off first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用的外掛合計超過 8 MB，請先停用一些外掛"
          }
        }
      }
    },
    "只支持 HTTPS 订阅链接：系统不允许 App 用不加密的 http:// 下载订阅。请向服务商索取 https:// 链接。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only HTTPS subscription links are supported: the system does not allow apps to download a subscription over unencrypted http://. Ask the provider for an https:// link."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只支援 HTTPS 訂閱連結：系統不允許 App 用未加密的 http:// 下載訂閱。請向服務商索取 https:// 連結。"
          }
        }
      }
    },
    "打开开关连接，首次需要允许添加 VPN 配置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on the switch to connect; the first time, allow adding the VPN configuration"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開開關連線，首次需要允許加入 VPN 設定"
          }
        }
      }
    },
    "轻点连接，首次需要允许添加 VPN 配置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to connect; the first time, allow adding the VPN configuration"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點連線，首次需要允許加入 VPN 設定"
          }
        }
      }
    },
    "已被其他 VPN 停用，打开开关重新启用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turned off by another VPN; turn on the switch to enable it again"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已被其他 VPN 停用，打開開關重新啟用"
          }
        }
      }
    },
    "已被其他 VPN 停用，轻点重新启用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turned off by another VPN; tap to enable it again"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已被其他 VPN 停用，輕點重新啟用"
          }
        }
      }
    },
    "断开 AnixOps Net": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect AnixOps Net"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中斷 AnixOps Net 連線"
          }
        }
      }
    },
    "允许 AnixOps Net 发送通知": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow AnixOps Net to Send Notifications"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 AnixOps Net 傳送通知"
          }
        }
      }
    },
    "在系统设置中开启通知": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn On Notifications in Settings"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在系統設定中開啟通知"
          }
        }
      }
    },
    "系统设置里关闭了 AnixOps Net 的通知，上面的开关目前不会发出任何通知。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications for AnixOps Net are turned off in the system settings, so the switches above send nothing for now."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統設定裡關閉了 AnixOps Net 的通知，上面的開關目前不會發出任何通知。"
          }
        }
      }
    },
    "删除节点“%@”？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete node “%@”?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除節點“%@”？"
          }
        }
      }
    },
    "一并删除 %lld 个节点": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete %lld Nodes"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一併刪除 %lld 個節點"
          }
        }
      }
    },
    "“%@”经由这个节点连接，删除后无法使用，会一并删除。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” connects through this node and would stop working without it, so it is deleted too."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”經由這個節點連線，刪除後無法使用，會一併刪除。"
          }
        }
      }
    },
    "删除节点…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Node…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除節點…"
          }
        }
      }
    },
    "“%@”已设为当前节点，正在重新连接。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is now the current node. Reconnecting…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已設為目前節點，正在重新連線。"
          }
        }
      }
    },
    "调试网络": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network debugging"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網路除錯"
          }
        }
      }
    },
    "抓包、解密 HTTPS、改写和重放请求。无需节点，流量默认直连。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture, decrypt HTTPS, rewrite and replay requests. No node needed; traffic goes direct by default."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擷取、解密 HTTPS、改寫和重送請求。無需節點，流量預設直連。"
          }
        }
      }
    },
    "导入订阅或节点，按规则把流量交给代理或直连。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import a subscription or nodes, and route traffic through a proxy or direct by rules."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入訂閱或節點，按規則把流量交給代理或直連。"
          }
        }
      }
    },
    "经过节点": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Through a node"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "經過節點"
          }
        }
      }
    },
    "选择使用方式": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a usage mode"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇使用方式"
          }
        }
      }
    },
    "继续": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續"
          }
        }
      }
    },
    "可在设置中切换，不会删除订阅、节点和插件。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can be changed later in Settings; subscriptions, nodes and plugins are kept."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可在設定中切換，不會刪除訂閱、節點和外掛。"
          }
        }
      }
    },
    "使用方式": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use AnixOps Net for"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用方式"
          }
        }
      }
    },
    "调试模式把请求放在首位，订阅和节点收进“出口”。切换不会删除任何数据，连接中会自动重连。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug mode puts requests first and keeps subscriptions and nodes under “Exit”. Switching deletes nothing; a connection reconnects automatically."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "除錯模式把請求放在首位，訂閱和節點收進「出口」。切換不會刪除任何資料，連線中會自動重新連線。"
          }
        }
      }
    },
    "代理模式按订阅规则分流。切换不会删除任何数据，连接中会自动重连。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy mode routes traffic by the subscription's rules. Switching deletes nothing; a connection reconnects automatically."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理模式按訂閱規則分流。切換不會刪除任何資料，連線中會自動重新連線。"
          }
        }
      }
    },
    "抓到的请求直接发往目标服务器，不经过任何节点。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Captured requests go straight to their servers, through no node."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擷取的請求直接發往目標伺服器，不經過任何節點。"
          }
        }
      }
    },
    "暂无节点，当前直连。导入后请求经所选节点发出。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No nodes yet; traffic goes direct. After import, requests leave through the selected node."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫無節點，目前直連。匯入後請求經所選節點發出。"
          }
        }
      }
    },
    "请求经过选中的节点发出，按订阅规则分流；可以切换节点对比不同地区的出口。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests leave through the selected node and are routed by the subscription's rules. Switch nodes to compare exits in different regions."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求經過選中的節點發出，按訂閱規則分流；可以切換節點比較不同地區的出口。"
          }
        }
      }
    },
    "屏蔽 QUIC": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block QUIC"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "封鎖 QUIC"
          }
        }
      }
    },
    "开启后拒绝 UDP 443 端口的 QUIC（HTTP/3）流量，浏览器和应用改用 TCP；直连和全局模式下同样生效。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, QUIC (HTTP/3) traffic to UDP port 443 is refused and browsers and apps switch to TCP; this also applies in Direct and Global mode."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後拒絕 UDP 443 連接埠的 QUIC（HTTP/3）流量，瀏覽器和應用程式改用 TCP；直連和全域模式下同樣生效。"
          }
        }
      }
    },
    "搜索或表达式，如 status:4xx": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search or expression, e.g. status:4xx"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋或運算式，如 status:4xx"
          }
        }
      }
    },
    "正在查看已保存的会话，抓包已停止": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Viewing a saved session; capture has stopped"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在檢視已儲存的工作階段，擷取已停止"
          }
        }
      }
    },
    "只列出 HTTPS 解密（MITM）后的请求和明文 HTTP 请求。搜索支持表达式，如 host:api.example.com status:>=400 -method:GET。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lists only requests decrypted from HTTPS (MITM) and plain HTTP requests. Search supports expressions such as host:api.example.com status:>=400 -method:GET."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只列出 HTTPS 解密（MITM）後的請求和明文 HTTP 請求。搜尋支援運算式，如 host:api.example.com status:>=400 -method:GET。"
          }
        }
      }
    },
    "全部连接": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All Connections"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全部連線"
          }
        }
      }
    },
    "保存当前抓包": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save Current Capture"
          }
        },
        "zh-Hant": {
