        }
      }
    },
    "拷贝用户名": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy Username"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拷貝使用者名稱"
          }
        }
      }
    },
    "拷贝密码": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy Password"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拷貝密碼"
          }
        }
      }
    },
    "显示密码": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Password"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示密碼"
          }
        }
      }
    },
    "隐藏密码": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide Password"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏密碼"
          }
        }
      }
    },
    "重新生成用户名和密码": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make a New Username and Password"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新產生使用者名稱和密碼"
          }
        }
      }
    },
    "用随机数生成，只保存在这台 Mac 的钥匙串里。重新生成后，已经设置过的手机要重新填写。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Randomly generated and kept only in this Mac's keychain. After making new ones, phones set up before must enter them again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以隨機數產生，只儲存在這台 Mac 的鑰匙圈裡。重新產生後，已經設定過的手機要重新填寫。"
          }
        }
      }
    },
    "任何人都能使用这个代理：同一网络里的任何设备都能通过这台 Mac 和你的节点上网，它们的请求也会进入抓包。只在可信的网络里关闭密码。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone can use this proxy: any device on the same network can go online through this Mac and your nodes, and its requests end up in the capture. Turn the password off only on a network you trust."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何人都能使用這個代理：同一網路裡的任何裝置都能透過這台 Mac 和你的節點上網，它們的請求也會進入抓包。只在可信的網路裡關閉密碼。"
          }
        }
      }
    },
    "iPhone：在 Wi-Fi 代理设置里打开认证，填上面的用户名和密码。Android 的 Wi-Fi 代理没有密码栏，浏览器会在第一次访问时询问，其他应用可能连不上。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone: turn on Authentication in the Wi-Fi proxy settings and enter the username and password above. Android's Wi-Fi proxy has no password field: the browser asks on the first visit, other apps may not connect."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone：在 Wi-Fi 代理設定裡開啟認證，填上面的使用者名稱和密碼。Android 的 Wi-Fi 代理沒有密碼欄，瀏覽器會在第一次造訪時詢問，其他 App 可能連不上。"
          }
        }
      }
    },
    "无法读取钥匙串里的手机抓包密码，手机抓包没有开启。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone debugging password could not be read from the keychain, so phone debugging did not turn on."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取鑰匙圈裡的手機抓包密碼，手機抓包沒有開啟。"
          }
        }
      }
    },
    "无法把手机抓包密码保存到钥匙串。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone debugging password could not be saved to the keychain."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法把手機抓包密碼儲存到鑰匙圈。"
          }
        }
      }
    },
    "手机抓包没有用新的设置重新开启，请关闭后再打开。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phone debugging did not restart with the new settings. Turn it off and on again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機抓包沒有用新的設定重新開啟，請關閉後再開啟。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
