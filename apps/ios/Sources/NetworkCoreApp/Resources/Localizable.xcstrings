            "state": "translated",
            "value": "回應"
          }
        }
      }
    },
    "时间线": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timeline"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
