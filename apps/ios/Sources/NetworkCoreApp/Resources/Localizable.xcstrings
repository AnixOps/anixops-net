          }
        }
      }
    },
    "加入网络时由系统立即执行，不需要打开 App。设为“断开”的网络下，手动连接也会被断开。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system applies these as soon as you join a network, without opening the app. On a network set to Disconnect, a manual connection is disconnected too."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入網路時由系統立即執行，不需要開啟 App。設為「斷開」的網路下，手動連線也會被斷開。"
          }
        }
      }
    },
    "删除 %@": {
      "localizations": {
        "en": {
