            "value": "Remove fallback"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消備用"
          }
        }
      }
    },
    "备用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fallback"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備用"
          }
        }
      }
    },
    "直连 · 本机网络的 DNS": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct · the local network's DNS"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直連 · 本機網路的 DNS"
          }
        }
      }
    },
    "阿里 DNS（DoQ，直连）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AliDNS (DoQ, direct)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "阿里 DNS（DoQ，直連）"
          }
        }
      }
    },
    "系统 DNS（本机网络，直连）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System DNS (local network, direct)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統 DNS（本機網路，直連）"
          }
        }
      }
    },
    "最多 4 个默认服务器同时查询": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At most 4 default servers can be asked at once"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 4 個預設伺服器同時查詢"
          }
        }
      }
    },
    "Fake-IP 开启时，Hosts 不能使用 198.18.0.0/15 或 fc00::/18 内的地址": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Fake-IP on, hosts cannot use addresses in 198.18.0.0/15 or fc00::/18"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Fake-IP 開啟時，Hosts 不能使用 198.18.0.0/15 或 fc00::/18 內的位址"
          }
        }
      }
    },
    "断开时自动保存": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved on disconnect"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "斷開時自動儲存"
          }
        }
      }
    },
    "另有 %lld 个连接没有解密出请求，查看域名 ›": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld more connections showed no decrypted requests. See their domains ›"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另有 %lld 個連線沒有解密出請求，查看網域 ›"
          }
        }
      }
    },
    "连接已断开，抓包随之停止。断开前抓到的内容已加密保存，连接后在 ⋯ › 已保存的会话 查看。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnected, so capture stopped. What it caught was saved encrypted; after connecting, open ⋯ › Saved Sessions to view it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線已斷開，抓包隨之停止。斷開前抓到的內容已加密儲存，連線後在 ⋯ › 已儲存的工作階段 查看。"
          }
        }
      }
    },
    "抓到的连接 · %lld 个域名或地址": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Captured connections · %lld domains or addresses"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "抓到的連線 · %lld 個網域或位址"
          }
        }
      }
    },
    "这些连接没有解密，只抓到了加密的 TLS 数据，点进去可以看原始字节。点“解密”把域名加入解密列表，隧道会重新连接，之后的新连接会被解密并列在上面。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These connections were not decrypted, so only encrypted TLS data was captured; open one to see the raw bytes. Tap “Decrypt” to add the domain to the decryption list: the tunnel reconnects and new connections are decrypted and listed above."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些連線沒有解密，只抓到了加密的 TLS 資料，點進去可以看原始位元組。點「解密」把網域加入解密列表，隧道會重新連線，之後的新連線會被解密並列在上面。"
          }
        }
      }
    },
    "这些连接没有解密，只抓到了加密的 TLS 数据，点进去可以看原始字节。点“解密”把域名加入解密列表，隧道会重新连接，之后的新连接会被解密并列在请求里。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These connections were not decrypted, so only encrypted TLS data was captured; open one to see the raw bytes. Tap “Decrypt” to add the domain to the decryption list: the tunnel reconnects and new connections are decrypted and listed with the requests."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些連線沒有解密，只抓到了加密的 TLS 資料，點進去可以看原始位元組。點「解密」把網域加入解密列表，隧道會重新連線，之後的新連線會被解密並列在請求裡。"
          }
        }
      }
    },
    "HTTPS 解密没有生效：隧道启动时找不到根证书。请在 改写 › HTTPS 解密证书 生成并信任，再重新连接。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS decryption is not active: the tunnel found no root certificate when it started. Create and trust one in Rewrite › HTTPS Decryption Certificate, then reconnect."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS 解密沒有生效：隧道啟動時找不到根憑證。請在 改寫 › HTTPS 解密憑證 產生並信任，再重新連線。"
          }
        }
      }
    },
    "HTTPS 解密没有生效：隧道读不到钥匙串里的根证书。请重新连接；仍不行就在 改写 › HTTPS 解密证书 重新生成。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS decryption is not active: the tunnel could not read the root certificate from the Keychain. Reconnect; if that does not help, create it again in Rewrite › HTTPS Decryption Certificate."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS 解密沒有生效：隧道讀不到鑰匙圈裡的根憑證。請重新連線；仍不行就在 改寫 › HTTPS 解密憑證 重新產生。"
          }
        }
      }
    },
    "HTTPS 解密没有生效：内核没有接受解密设置。请检查已启用的插件，开发者诊断的扩展事件里有原因。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS decryption is not active: the engine did not accept the decryption settings. Check the enabled plugins; the extension events in developer diagnostics give the reason."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS 解密沒有生效：核心沒有接受解密設定。請檢查已啟用的外掛，開發者診斷的擴充事件裡有原因。"
          }
        }
      }
    },
    "已把 %@ 加入解密列表，隧道正在重新连接；之后的新连接会列出请求。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added %@ to the decryption list. The tunnel is reconnecting; new connections will list their requests."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已把 %@ 加入解密列表，隧道正在重新連線；之後的新連線會列出請求。"
          }
        }
      }
    },
    "已抓到 %lld 个连接，但没有一个解密出请求，所以这里还是空的。下面按域名列出了这些连接。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Captured %lld connections, but none were decrypted into requests, so this list is empty. They are listed by domain below."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已抓到 %lld 個連線，但沒有一個解密出請求，所以這裡還是空的。下面按網域列出了這些連線。"
          }
        }
      }
    },
    "解密": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decrypt"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解密"
          }
        }
      }
    },
    "解密 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decrypt %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解密 %@"
          }
        }
      }
    },
    "%lld 个连接 · %@ · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld connections · %2$@ · %3$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個連線 · %@ · %@"
          }
        }
      }
    },
    "只有 IP 地址，没有域名可以解密": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "IP address only, no domain to decrypt"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有 IP 位址，沒有網域可以解密"
          }
        }
      }
    },
    "已在解密列表，但没有解密出请求：可能是加入前建立的连接、App 固定了证书，或不是 443 端口的 HTTPS": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the decryption list, but no requests were decrypted: the connections may predate the domain, the app may pin its certificate, or it is not HTTPS on port 443"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已在解密列表，但沒有解密出請求：可能是加入前建立的連線、App 固定了憑證，或不是 443 埠的 HTTPS"
          }
        }
      }
    },
    "未解密，只抓到加密数据": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not decrypted, encrypted data only"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未解密，只抓到加密資料"
          }
        }
      }
    },
    "所有抓到的连接都解密出了请求。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every captured connection was decrypted into requests."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有抓到的連線都解密出了請求。"
          }
        }
      }
    },
    "没有请求的连接": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connections Without Requests"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有請求的連線"
          }
        }
      }
    },
    "已保存的会话": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved Sessions"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的工作階段"
          }
        }
      }
    },
    "%lld 个域名，%lld 个排除": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld domains, %2$lld excluded"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 個網域，%2$lld 個排除"
          }
        }
      }
    },
    "* 匹配任意字符（包括点），? 匹配一个字符；*.example.com 匹配所有子域名，不含 example.com 本身。排除的域名永不解密，优先于这里、插件和映射里的所有解密规则；也可以直接写 -example.com。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "* matches any characters (dots included) and ? one character; *.example.com matches every subdomain but not example.com itself. Excluded domains are never decrypted and win over every decryption rule here, in plugins and in mappings; you can also type -example.com."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "* 符合任意字元（包括點），? 符合一個字元；*.example.com 符合所有子網域，不含 example.com 本身。排除的網域永不解密，優先於這裡、外掛和對應裡的所有解密規則；也可以直接寫 -example.com。"
          }
        }
      }
    },
    "排除": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclude"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排除"
          }
        }
      }
    },
    "排除 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclude %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排除 %@"
          }
        }
      }
    },
    "已排除": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluded"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已排除"
          }
        }
      }
    },
    "清除这些记录": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear These Records"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除這些記錄"
          }
        }
      }
    },
    "解密失败": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decryption Failed"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解密失敗"
          }
        }
      }
    },
    "根据本机这次连接以来的解密结果自动标出，只记录域名、次数和原因，断开后清空。App 拒绝证书多半是证书固定：它只信任自己的证书，无法解密。排除后它的连接原样转发，App 会照常联网。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marked automatically from this device's decryption results since it connected. Only domains, counts and reasons are kept, and they are cleared on disconnect. An app that refuses the certificate usually pins its certificate: it trusts only its own, so it cannot be decrypted. Once excluded, its connections pass through untouched and the app works normally."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據本機這次連線以來的解密結果自動標出，只記錄網域、次數和原因，中斷後清空。App 拒絕憑證多半是憑證固定：它只信任自己的憑證，無法解密。排除後它的連線原樣轉送，App 會照常連網。"
          }
        }
      }
    },
    "停用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停用"
          }
        }
      }
    },
    "启用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn On"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用"
          }
        }
      }
    },
    "改为解密": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decrypt Instead"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改為解密"
          }
        }
      }
    },
    "改为排除": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclude Instead"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改為排除"
          }
        }
      }
    },
    "来自插件和映射": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From Plugins and Mappings"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自外掛和對應"
          }
        }
      }
    },
    "在插件和映射里修改。这里的排除同样作用于它们。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change these in plugins and mappings. Exclusions here apply to them too."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在外掛和對應裡修改。這裡的排除同樣作用於它們。"
          }
        }
      }
    },
    "哪些 HTTPS 能解密": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which HTTPS Can Be Decrypted"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "哪些 HTTPS 能解密"
          }
        }
      }
    },
    "域名在列表里（或插件、映射里）、没有被排除，并且已经信任 HTTPS 解密证书。加入后新建的连接才会解密，之前的连接要等 App 重新连接。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A domain in this list (or in a plugin or mapping) that is not excluded, once the HTTPS decryption certificate is trusted. Only connections made after it is added are decrypted; earlier ones wait until the app reconnects."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網域在列表裡（或外掛、對應裡）、沒有被排除，並且已經信任 HTTPS 解密憑證。加入後新建的連線才會解密，之前的連線要等 App 重新連線。"
          }
        }
      }
    },
    "只解密 443 端口的 HTTPS。列表里域名的 HTTP/3（QUIC）连接会被拒绝，让 App 改用可以解密的 HTTPS。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only HTTPS on port 443 is decrypted. HTTP/3 (QUIC) connections to listed domains are refused so the app falls back to HTTPS, which can be decrypted."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只解密 443 連接埠的 HTTPS。列表裡網域的 HTTP/3（QUIC）連線會被拒絕，讓 App 改用可以解密的 HTTPS。"
          }
        }
      }
    },
    "不能解密：固定了证书的 App（常见于银行、支付和系统服务），以及只有 IP 地址、没有域名的连接。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not decryptable: apps that pin their certificate (common for banking, payments and system services), and connections with only an IP address and no domain."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不能解密：固定了憑證的 App（常見於銀行、支付和系統服務），以及只有 IP 位址、沒有網域的連線。"
          }
        }
      }
    },
    "已停用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已停用"
          }
        }
      }
    },
    "已解密 %lld 个连接，%lld 个域名失败": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld connections decrypted, %2$lld domains failed"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已解密 %1$lld 個連線，%2$lld 個網域失敗"
