            "value": "上傳"
          }
        }
      }
    },
    "上传、下载为该连接经隧道的字节数；目标域名仅保存在内存，断开隧道即清空。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload and download are the bytes this connection moved through the tunnel; host names are kept in memory only and cleared when the tunnel stops."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上傳、下載為該連線經隧道的位元組數；目標網域僅儲存在記憶體，斷開隧道即清空。"
          }
        }
      }
    },
    "上次下载失败：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last download failed: %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上次下載失敗：%@"
