    "替换为团队已有的 CA，各设备信任同一根证书。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replaces the root with the team's existing CA; all devices trust the same root."
          }
        },
        "zh-Hant": {
