      }
    },
    "内置：本机和局域网地址": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built in: this device and local network addresses"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內建：本機和區域網路位址"
          }
        }
      }
    },
    "列表里有 %lld 条规则不支持，已跳过：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld rules in the list aren't supported and were skipped: %@"
          }
        },
        "zh-Hant": {
