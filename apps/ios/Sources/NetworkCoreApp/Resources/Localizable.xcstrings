      }
    },
    "请求延迟": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request latency"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求延遲"
          }
        }
      }
    },
    "负载下延迟": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loaded latency"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "負載下延遲"
          }
        }
      }
    },
    "达到 200 MB 上限，提前结束。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped early at the 200 MB limit."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "達到 200 MB 上限，提前結束。"
          }
        }
      }
    },
    "这种节点不支持体检": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This kind of node can't be checked"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這種節點不支持體檢"
          }
        }
      }
    },
    "首次握手": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First handshake"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首次握手"
          }
        }
      }
    },
    "向订阅服务商报告连接质量": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report connection quality to subscription provider"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向訂閱服務商回報連線品質"
          }
        }
      }
    },
    "开启后，App 打开且已连接时，约每小时把 ANX 节点的连接计数发给提供这些节点的订阅服务商：发往订阅链接去掉参数和扩展名后加 /report 的地址，链接里的令牌随之发出，服务商能据此对应到你的账号。内容为 App 版本、平台、网络类型（Wi-Fi、蜂窝、有线）、统计时长，以及每个节点的名称、服务器地址和端口、协议、成功和各类失败次数、是否因被拒而暂停、时间偏差；不含你访问的网址。默认关闭，关闭时删除保存的计数。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, while the app is open and connected, about once an hour the app sends the connection counts of ANX nodes to the subscription provider that supplied them: to the subscription link without its query and extension, plus /report. The token in the link goes with it, so the provider can match the report to your account. It contains the app version, platform, network type (Wi-Fi, cellular, wired), the period covered, and for each node its name, server address and port, protocol, success and failure counts, whether it was paused after rejections, and clock offset; never the sites you visit. Off by default; turning it off deletes the saved counts."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，App 開啟且已連線時，約每小時把 ANX 節點的連線計數傳給提供這些節點的訂閱服務商：傳往訂閱連結去掉參數和副檔名後加 /report 的位址，連結裡的權杖隨之送出，服務商能據此對應到你的帳號。內容為 App 版本、平台、網路類型（Wi-Fi、行動網路、有線）、統計時長，以及每個節點的名稱、伺服器位址和連接埠、協定、成功和各類失敗次數、是否因被拒而暫停、時間偏差；不含你造訪的網址。預設關閉，關閉時刪除儲存的計數。"
          }
        }
      }
    },
    "消息 %lld · %lld 字节": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message %lld · %lld bytes"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訊息 %lld · %lld 位元組"
          }
        }
      }
    },
    "这条消息是压缩的，导出正文后用其他工具解开。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This message is compressed. Export the body and decompress it with another tool."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這條訊息是壓縮的，匯出正文後用其他工具解開。"
          }
        }
      }
    },
    "尾部": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trailers"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尾部"
          }
        }
      }
    },
    "这条消息不是 Protobuf，见十六进制。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This message is not Protobuf. See Hex."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這條訊息不是 Protobuf，見十六進位。"
          }
        }
      }
    },
    "…（只解析了开头部分）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "… (only the start was decoded)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "…（只解析了開頭部分）"
          }
        }
      }
    },
    "导出正文": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export Body"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出正文"
          }
        }
      }
    },
    "用其他应用打开": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in Another App"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用其他應用程式開啟"
          }
        }
      }
    },
    "图片太大（%lld × %lld），不在这里画出；可以导出后用其他应用查看。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image is too large to draw here (%lld × %lld). Export it to view it in another app."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片太大（%lld × %lld），不在這裡畫出；可以匯出後用其他應用程式檢視。"
          }
        }
      }
    },
    "由旧版本导入：更新后证书固定才会生效": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported by an earlier version: update it to apply certificate pins"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由舊版本匯入：更新後憑證固定才會生效"
          }
        }
      }
    },
    "由旧版本导入：重新导入后证书固定才会生效": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported by an earlier version: import it again to apply certificate pins"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由舊版本匯入：重新匯入後憑證固定才會生效"
          }
        }
      }
    },
    "无法把新根证书记录到 VPN 配置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't record the new root certificate in the VPN configuration"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法把新根憑證記錄到 VPN 設定"
          }
        }
      }
    },
    "HTTPS 解密证书已更换，隧道仍在用旧证书签发。请断开再连接。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The HTTPS decryption certificate changed, but the tunnel still issues certificates from the old one. Disconnect and connect again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS 解密憑證已更換，通道仍在用舊憑證簽發。請斷開再連線。"
          }
        }
      }
    },
    "连接已断开，抓包随之停止。这台设备上无法保存会话，断开前抓到的内容没有保存。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnected, so capture stopped. Sessions can't be saved on this device, so what it caught was not saved."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線已斷開，抓包隨之停止。這台裝置上無法儲存工作階段，斷開前抓到的內容沒有儲存。"
          }
        }
      }
    },
    "连接已断开，抓包随之停止。断开时会尝试加密保存抓到的内容，连接后在 ⋯ › 已保存的会话 查看是否保存成功。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnected, so capture stopped. What it caught is saved encrypted if possible; after connecting, check ⋯ › Saved Sessions to see whether it was."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線已斷開，抓包隨之停止。斷開時會嘗試加密儲存抓到的內容，連線後在 ⋯ › 已儲存的工作階段 查看是否儲存成功。"
          }
        }
      }
    },
    "会话用只保存在这台 Mac 上的密钥加密，只有系统级的隧道扩展能读取，保留 7 天后自动删除。打开会话会替换当前的抓包内容并停止抓包，之后可以照常查看、筛选和导出。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessions are encrypted with a key kept only on this Mac, readable only by the system tunnel extension, and deleted after 7 days. Opening a session replaces the current capture and stops capturing; you can then view, filter and export it as usual."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作階段用只保存在這台 Mac 上的金鑰加密，只有系統級的通道延伸功能能讀取，保留 7 天後自動刪除。開啟工作階段會取代目前的抓包內容並停止抓包，之後可以照常查看、篩選和匯出。"
          }
        }
      }
    },
    "这台 Mac 上无法保存会话（隧道扩展读不到会话密钥，开发者诊断的扩展事件里有原因）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessions can't be saved on this Mac (the tunnel extension can't read the session key; the extension events in developer diagnostics say why)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 上無法儲存工作階段（通道延伸功能讀不到工作階段金鑰，開發者診斷的延伸功能事件裡有原因）。"
          }
        }
      }
    },
    "已连接的隧道会自动重新连接并改用新证书。系统会要求输入登录密码，撤销这台 Mac 对旧证书的信任；新证书需要重新加入钥匙串并信任。其他装过旧证书的设备要分别删除它。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A connected tunnel reconnects on its own and uses the new certificate. macOS asks for your login password to stop trusting the old certificate on this Mac; the new one must be added to the keychain and trusted again. Remove the old certificate from other devices that have it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已連線的通道會自動重新連線並改用新憑證。系統會要求輸入登入密碼，撤銷這台 Mac 對舊憑證的信任；新憑證需要重新加入鑰匙圈並信任。其他裝過舊憑證的裝置要分別刪除它。"
          }
        }
      }
    },
    "证书和私钥只保存在本机钥匙串。重新生成或换成自己的根证书后，已连接的隧道会自动重新连接，这台 Mac 撤销对旧证书的信任；已安装旧证书的其他设备要改装新证书。如果“信任证书”没有成功：在“钥匙串访问”中双击这张证书，展开“信任”，把“使用此证书时”设为“始终信任”。Firefox 使用自己的证书列表，需要另外导入。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The certificate and its private key stay in this Mac's keychain. After regenerating or switching to your own root, a connected tunnel reconnects on its own and this Mac stops trusting the old certificate; install the new one on other devices that have the old one. If Trust Certificate did not work: double-click the certificate in Keychain Access, expand Trust and set When using this certificate to Always Trust. Firefox keeps its own certificate list and needs a separate import."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "憑證和私鑰只保存在本機鑰匙圈。重新產生或換成自己的根憑證後，已連線的通道會自動重新連線，這台 Mac 撤銷對舊憑證的信任；已安裝舊憑證的其他裝置要改裝新憑證。如果「信任憑證」沒有成功：在「鑰匙圈存取」中按兩下這張憑證，展開「信任」，把「使用此憑證時」設為「永遠信任」。Firefox 使用自己的憑證列表，需要另外匯入。"
          }
        }
      }
    },
    "已取消。旧证书“%@”仍受这台 Mac 信任：在“钥匙串访问”中找到它，删除它或把信任改回“使用系统默认”。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelled. This Mac still trusts the old certificate “%@”: find it in Keychain Access and delete it, or set its trust back to Use System Defaults."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消。舊憑證「%@」仍受這台 Mac 信任：在「鑰匙圈存取」中找到它，刪除它或把信任改回「使用系統預設值」。"
          }
        }
      }
    },
    "无法撤销对旧证书“%@”的信任（%@）。请在“钥匙串访问”中删除这张证书。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't stop trusting the old certificate “%@” (%@). Delete it in Keychain Access."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法撤銷對舊憑證「%@」的信任（%@）。請在「鑰匙圈存取」中刪除這張憑證。"
          }
        }
      }
    },
    "旧证书“%@”仍受这台 Mac 信任，信任设置不在当前用户名下，App 无权更改。请在“钥匙串访问”的“系统”钥匙串中删除它。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac still trusts the old certificate “%@” through a setting outside your user account that the app can't change. Delete it from the System keychain in Keychain Access."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舊憑證「%@」仍受這台 Mac 信任，信任設定不在目前使用者名下，App 無權更改。請在「鑰匙圈存取」的「系統」鑰匙圈中刪除它。"
          }
        }
      }
    },
    "已撤销对旧证书“%@”的信任，但没能把它从钥匙串删除（%@），可以在“钥匙串访问”中手动删除。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac no longer trusts the old certificate “%@”, but it couldn't be removed from the keychain (%@); you can delete it in Keychain Access."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已撤銷對舊憑證「%@」的信任，但沒能把它從鑰匙圈刪除（%@），可以在「鑰匙圈存取」中手動刪除。"
          }
        }
      }
    },
    "粘贴 PEM 格式的 CA 证书和它的私钥。私钥需要是 P-256（prime256v1）密钥，只保存在本机钥匙串。替换后已连接的隧道会自动重新连接，这台 Mac 撤销对旧证书的信任（需要登录密码）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the CA certificate and its private key in PEM format. The key must be a P-256 (prime256v1) key and stays in this Mac's keychain. After the switch a connected tunnel reconnects on its own and this Mac stops trusting the old certificate (your login password is needed)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上 PEM 格式的 CA 憑證和它的私鑰。私鑰需要是 P-256（prime256v1）金鑰，只保存在本機鑰匙圈。替換後已連線的通道會自動重新連線，這台 Mac 撤銷對舊憑證的信任（需要登入密碼）。"
          }
        }
      }
    },
    "已连接的隧道会自动重新连接并改用新证书。新证书需要重新安装并信任，之后请删除旧描述文件。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A connected tunnel reconnects on its own and uses the new certificate. Install and trust the new one, then delete the old profile."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已連線的通道會自動重新連線並改用新憑證。新憑證需要重新安裝並信任，之後請刪除舊描述檔。"
          }
        }
      }
    },
    "重新生成后已连接的隧道会自动重新连接，改用新证书签发；新证书需要重新安装并信任。请同时在 设置 > 通用 > VPN与设备管理 删除旧描述文件，否则旧证书仍受这台设备信任。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After regenerating, a connected tunnel reconnects on its own and issues certificates from the new root; install and trust the new one. Also delete the old profile in Settings > General > VPN & Device Management, or this device keeps trusting the old certificate."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新產生後已連線的通道會自動重新連線，改用新憑證簽發；新憑證需要重新安裝並信任。請同時在 設定 > 一般 > VPN與裝置管理 刪除舊描述檔，否則舊憑證仍受這台裝置信任。"
          }
        }
      }
    },
    "插件只解密自己 [MITM] 列出的主机，解密域名和映射不受这个开关影响、另外生效；明文 HTTP 全部交给插件处理，仅支持 HTTP/1.1。使用前需要先连上 VPN。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugins decrypt only the hosts under their own [MITM]; decrypted domains and mappings work regardless of this switch. Plain HTTP always goes through plugins. HTTP/1.1 only. Connect the VPN first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "外掛只解密自己 [MITM] 列出的主機，解密網域和對應不受這個開關影響、另外生效；明文 HTTP 全部交給外掛處理，僅支援 HTTP/1.1。使用前需要先連上 VPN。"
          }
        }
      }
    },
    "网络扩展保存的配置副本已过期。请打开 App 重新连接。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The network extension's copy of the configuration is out of date. Open the app and connect again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網路擴充功能保存的設定副本已過期。請開啟 App 重新連線。"
          }
        }
      }
    },
    "网络扩展保存的配置副本已过期，自动重连没有成功。请重新连接。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The network extension's copy of the configuration is out of date, and reconnecting automatically did not work. Connect again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網路擴充功能保存的設定副本已過期，自動重新連線沒有成功。請重新連線。"
          }
        }
      }
    },
    "按网络选择": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By network"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按網路選擇"
          }
        }
      }
    },
    "由旧版本导入：更新后按网络选择的策略组才会生效": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported by an earlier version: update it to apply its by-network groups"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由舊版本匯入：更新後按網路選擇的策略組才會生效"
          }
        }
      }
    },
    "由旧版本导入：重新导入后按网络选择的策略组才会生效": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported by an earlier version: import it again to apply its by-network groups"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由舊版本匯入：重新匯入後按網路選擇的策略組才會生效"
          }
        }
      }
    },
    "规则没有生效：节点、规则和已启用的插件合计超出了隧道配置的上限，隧道只用选中的节点。请减少规则或规则集、停用一些插件后重新连接。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules are not in effect: the nodes, rules and enabled plugins together exceed the tunnel's configuration limit, so the tunnel uses only the selected node. Remove some rules or rule sets, or turn off some plugins, then reconnect."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "規則沒有生效：節點、規則和已啟用的外掛合計超出了隧道設定的上限，隧道只用選中的節點。請減少規則或規則集、停用一些外掛後重新連線。"
          }
        }
      }
    },
    "规则没有生效：内核没有接受分流设置，隧道只用选中的节点。开发者诊断的扩展事件里有原因。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules are not in effect: the engine did not accept the routing settings, so the tunnel uses only the selected node. The extension events in developer diagnostics give the reason."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "規則沒有生效：核心沒有接受分流設定，隧道只用選中的節點。開發者診斷的擴充事件裡有原因。"
          }
        }
      }
    },
    "规则集超过 %lld 个，以下规则集和用到它们的规则没有生效：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More than %lld rule sets: these rule sets, and the rules that use them, are not in effect: %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "規則集超過 %lld 個，以下規則集和用到它們的規則沒有生效：%@"
          }
        }
      }
    },
    "HTTPS 解密没有生效：已启用的插件和调试映射合计超出了隧道配置的上限，隧道没有交给内核。请停用一些插件或减少映射正文，再重新连接。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS decryption is not active: the enabled plugins and debug mappings together exceed the tunnel's configuration limit, so the tunnel did not pass them to the engine. Turn off some plugins or shorten mapping bodies, then reconnect."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS 解密沒有生效：已啟用的外掛和除錯對應合計超出了隧道設定的上限，隧道沒有交給核心。請停用一些外掛或減少對應內文，再重新連線。"
          }
        }
      }
    },
    "有 %lld 条重定向内核无法使用，不会生效。请编辑或删除标出的条目。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld redirects can't be used by the engine and are not in effect. Edit or delete the marked entries."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 條重新導向核心無法使用，不會生效。請編輯或刪除標出的項目。"
          }
        }
      }
    },
    "无效，不会生效": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid, not in effect"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無效，不會生效"
          }
        }
      }
    },
    "映射合计超过 4 MB（响应体按 Base64 计算，约为原大小的 4/3）。请删除或缩小一些 Map Local 响应体。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappings exceed 4 MB in total (response bodies count in Base64, about 4/3 of their size). Delete or shrink some Map Local response bodies."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對應合計超過 4 MB（回應內文按 Base64 計算，約為原大小的 4/3）。請刪除或縮小一些 Map Local 回應內文。"
          }
        }
      }
    },
    "已启用的插件和调试映射合计超过 64 KB，超出本版本隧道配置的上限：连接时 HTTPS 解密会被关闭，插件和映射都不会生效。请停用一些插件或减少映射响应体。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabled plugins and debug mappings exceed 64 KB in total, over this version's tunnel configuration limit: HTTPS decryption will be turned off when you connect, and neither plugins nor mappings will apply. Turn off some plugins or shrink mapping response bodies."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已啟用的外掛和除錯對應合計超過 64 KB，超出本版本隧道設定的上限：連線時 HTTPS 解密會被關閉，外掛和對應都不會生效。請停用一些外掛或減少對應回應內文。"
          }
        }
      }
    },
    "映射和已启用的插件合计超过 8 MB。请减少映射响应体或停用一些插件。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappings and enabled plugins exceed 8 MB in total. Shrink mapping response bodies or turn off some plugins."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對應和已啟用的外掛合計超過 8 MB。請減少對應回應內文或停用一些外掛。"
          }
        }
      }
    },
    "启用的插件和调试映射合计超过 8 MB，请先停用一些插件或减少映射响应体": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabled plugins and debug mappings exceed 8 MB in total. Turn some plugins off or shrink mapping response bodies first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用的外掛和除錯對應合計超過 8 MB，請先停用一些外掛或減少對應回應內文"
          }
        }
      }
    },
    "DNS 规则合计最多 %lld 个域名、后缀和关键词。较长的列表请改用 RULE-SET 或 GEOSITE 规则集。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS rules can list at most %lld domains, suffixes and keywords in total. Use a RULE-SET or GEOSITE rule set for longer lists."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS 規則合計最多 %lld 個網域、後綴和關鍵字。較長的列表請改用 RULE-SET 或 GEOSITE 規則集。"
          }
        }
      }
    },
    "已用 %lld / %lld 个域名、后缀和关键词": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld of %lld domains, suffixes and keywords used"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已用 %lld / %lld 個網域、後綴和關鍵字"
          }
        }
      }
    },
    "超出上限，排在后面的规则不会生效。请删除一些规则，较长的列表改用 RULE-SET 或 GEOSITE 规则集。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over the limit: the last rules are not in effect. Delete some rules, and use a RULE-SET or GEOSITE rule set for longer lists."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "超出上限，排在後面的規則不會生效。請刪除一些規則，較長的列表改用 RULE-SET 或 GEOSITE 規則集。"
          }
        }
      }
    },
    "启用的插件合计超过 8 MB，请先停用一些插件": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabled plugins exceed 8 MB in total. Turn some off first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用的外掛合計超過 8 MB，請先停用一些外掛"
          }
        }
      }
    },
    "只支持 HTTPS 订阅链接：系统不允许 App 用不加密的 http:// 下载订阅。请向服务商索取 https:// 链接。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only HTTPS subscription links are supported: the system does not let apps download a subscription over unencrypted http://. Ask your provider for an https:// link."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只支援 HTTPS 訂閱連結：系統不允許 App 用未加密的 http:// 下載訂閱。請向服務商索取 https:// 連結。"
          }
        }
      }
    },
    "打开开关连接，首次需要允许添加 VPN 配置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on the switch to connect; the first time, allow adding the VPN configuration"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開開關連線，首次需要允許加入 VPN 設定"
          }
        }
      }
    },
    "轻点连接，首次需要允许添加 VPN 配置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to connect; the first time, allow adding the VPN configuration"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點連線，首次需要允許加入 VPN 設定"
          }
        }
      }
    },
    "已被其他 VPN 停用，打开开关重新启用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turned off by another VPN; turn on the switch to enable it again"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已被其他 VPN 停用，打開開關重新啟用"
          }
        }
      }
    },
    "已被其他 VPN 停用，轻点重新启用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turned off by another VPN; tap to enable it again"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已被其他 VPN 停用，輕點重新啟用"
          }
        }
      }
    },
    "断开 AnixOps Net": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect AnixOps Net"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中斷 AnixOps Net 連線"
          }
        }
      }
    },
    "允许 AnixOps Net 发送通知": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow AnixOps Net to Send Notifications"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 AnixOps Net 傳送通知"
          }
        }
      }
    },
    "在系统设置中开启通知": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn On Notifications in Settings"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在系統設定中開啟通知"
          }
        }
      }
    },
    "系统设置里关闭了 AnixOps Net 的通知，上面的开关目前不会发出任何通知。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications for AnixOps Net are turned off in the system settings, so the switches above send nothing for now."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統設定裡關閉了 AnixOps Net 的通知，上面的開關目前不會發出任何通知。"
          }
        }
      }
    },
    "删除节点“%@”？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete node “%@”?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除節點“%@”？"
          }
        }
      }
    },
    "一并删除 %lld 个节点": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete %lld Nodes"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一併刪除 %lld 個節點"
          }
        }
      }
    },
    "“%@”经由这个节点连接，删除后无法使用，会一并删除。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” connects through this node and would stop working without it, so it is deleted too."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”經由這個節點連線，刪除後無法使用，會一併刪除。"
          }
        }
      }
    },
    "删除节点…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Node…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除節點…"
          }
        }
      }
    },
    "“%@”已设为当前节点，正在重新连接。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is now the current node. Reconnecting…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已設為目前節點，正在重新連線。"
          }
        }
      }
    },
    "调试网络": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network debugging"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網路除錯"
          }
        }
      }
    },
    "抓包、解密 HTTPS、改写和重放请求，给 App 开发和测试用。不需要节点，流量默认直连。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture, decrypt HTTPS, rewrite and replay requests, for app development and testing. No node needed; traffic goes direct by default."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擷取、解密 HTTPS、改寫和重送請求，給 App 開發和測試用。不需要節點，流量預設直連。"
          }
        }
      }
    },
    "导入订阅或节点，按规则把流量交给代理或直连。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import a subscription or nodes, and route traffic through a proxy or direct by rules."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入訂閱或節點，按規則把流量交給代理或直連。"
          }
        }
      }
    },
    "经过节点": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Through a node"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "經過節點"
          }
        }
      }
    },
    "你想怎么用\nAnixOps Net？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do you want\nto use AnixOps Net?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你想怎麼用\nAnixOps Net？"
          }
        }
      }
    },
    "继续": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續"
          }
        }
      }
    },
    "以后可以在设置里切换，切换不会删除订阅、节点和插件。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can switch later in Settings. Switching doesn't delete subscriptions, nodes or plugins."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以後可以在設定裡切換，切換不會刪除訂閱、節點和外掛。"
          }
        }
      }
    },
    "使用方式": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use AnixOps Net for"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用方式"
          }
        }
      }
    },
    "调试模式把请求放在首位，订阅和节点收进“出口”。切换不会删除任何数据，连接中会自动重连。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug mode puts requests first and keeps subscriptions and nodes under “Exit”. Switching deletes nothing; a connection reconnects automatically."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "除錯模式把請求放在首位，訂閱和節點收進「出口」。切換不會刪除任何資料，連線中會自動重新連線。"
          }
        }
      }
    },
    "代理模式按订阅规则分流。切换不会删除任何数据，连接中会自动重连。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy mode routes traffic by the subscription's rules. Switching deletes nothing; a connection reconnects automatically."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理模式按訂閱規則分流。切換不會刪除任何資料，連線中會自動重新連線。"
          }
        }
      }
    },
    "抓到的请求直接发往目标服务器，不经过任何节点。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Captured requests go straight to their servers, through no node."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擷取的請求直接發往目標伺服器，不經過任何節點。"
          }
        }
      }
    },
    "还没有节点，暂时直连。导入订阅或节点后，请求经过选中的节点发出，可以用来对比不同地区的出口。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No nodes yet, so traffic goes direct for now. Once you import a subscription or nodes, requests leave through the selected node, so you can compare exits in different regions."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有節點，暫時直連。匯入訂閱或節點後，請求經過選中的節點發出，可以用來比較不同地區的出口。"
          }
        }
      }
    },
    "请求经过选中的节点发出，按订阅规则分流；可以切换节点对比不同地区的出口。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests leave through the selected node and are routed by the subscription's rules. Switch nodes to compare exits in different regions."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求經過選中的節點發出，按訂閱規則分流；可以切換節點比較不同地區的出口。"
          }
        }
      }
    },
    "屏蔽 QUIC": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block QUIC"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "封鎖 QUIC"
          }
        }
      }
    },
    "开启后拒绝发往 UDP 443 端口的 QUIC（HTTP/3）流量，浏览器和应用会立即改用 TCP，这样 MITM 插件和按域名分流的规则都能生效。直连和全局模式下同样生效。代价是部分视频和网页在弱网下可能稍慢。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, QUIC (HTTP/3) traffic to UDP port 443 is refused, so browsers and apps switch to TCP at once and MITM plugins and domain rules can apply. This also applies in Direct and Global mode. Some videos and pages may load a little slower on a weak network."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後拒絕發往 UDP 443 連接埠的 QUIC（HTTP/3）流量，瀏覽器和應用程式會立即改用 TCP，這樣 MITM 外掛和按網域分流的規則都能生效。直連和全域模式下同樣生效。代價是部分影片和網頁在弱網路下可能稍慢。"
          }
        }
      }
    },
    "搜索或表达式，如 status:4xx": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search or expression, e.g. status:4xx"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋或運算式，如 status:4xx"
          }
        }
      }
    },
    "正在查看已保存的会话，抓包已停止": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Viewing a saved session; capture has stopped"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在檢視已儲存的工作階段，擷取已停止"
          }
        }
      }
    },
    "只列出 HTTPS 解密（MITM）后的请求和明文 HTTP 请求。搜索框可以直接写表达式：host:api.example.com status:>=400 type:json -method:GET，空格表示同时满足，OR 表示或者。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lists only requests decrypted from HTTPS (MITM) and plain HTTP requests. The search field takes expressions: host:api.example.com status:>=400 type:json -method:GET. A space means both must match; OR means either."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只列出 HTTPS 解密（MITM）後的請求和明文 HTTP 請求。搜尋框可以直接寫運算式：host:api.example.com status:>=400 type:json -method:GET，空格表示同時符合，OR 表示或者。"
          }
        }
      }
    },
    "全部连接": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All Connections"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全部連線"
          }
        }
      }
    },
    "保存当前抓包": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save Current Capture"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存目前擷取"
          }
        }
      }
    },
    "图片": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片"
          }
        }
      }
    },
    "非 GET": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not GET"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "非 GET"
          }
        }
      }
    },
    "大于 100 KB": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over 100 KB"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大於 100 KB"
          }
        }
      }
    },
    "本地应答": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answered locally"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機回應"
          }
        }
      }
    },
    "连接后，经过隧道的 HTTP 请求会逐条列在这里。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once connected, HTTP requests through the tunnel are listed here one by one."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線後，經過隧道的 HTTP 請求會逐條列在這裡。"
          }
        }
      }
    },
    "当前内核不支持请求列表，请在右上角查看全部连接。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This engine version has no request list. See all connections at the top right."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前核心不支援請求列表，請在右上角查看全部連線。"
          }
        }
      }
    },
    "抓包未开启。开始抓包后，新的请求会出现在这里。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture is off. Once you start capturing, new requests appear here."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擷取未開啟。開始擷取後，新的請求會出現在這裡。"
          }
        }
      }
    },
    "表达式有误，改正后再筛选。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The expression has an error. Fix it to filter."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "運算式有誤，改正後再篩選。"
          }
        }
      }
    },
    "没有匹配的请求": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No matching requests"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有符合的請求"
          }
        }
      }
    },
    "还没有请求。要看到 HTTPS 请求，请在 扩展 › HTTPS 解密证书 中安装并信任根证书，再为域名启用解密。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No requests yet. To see HTTPS requests, install and trust the root certificate in Extensions › HTTPS Decryption Certificate, then turn on decryption for the domains."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有請求。要看到 HTTPS 請求，請在 擴充功能 › HTTPS 解密憑證 中安裝並信任根憑證，再為網域啟用解密。"
          }
        }
      }
    },
    "表达式有误": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The expression has an error"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "運算式有誤"
          }
        }
      }
    },
    "无法保存会话": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save the session"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存工作階段"
          }
        }
      }
    },
    "改写未生效": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rewrite not applied"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改寫未生效"
          }
        }
      }
    },
    "删除会话": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Session"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除工作階段"
          }
        }
      }
    },
    "打开会话": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Session"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟工作階段"
          }
        }
      }
    },
    "当前未保存的抓包内容会被替换，抓包会停止。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current unsaved capture is replaced and capture stops."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前未儲存的擷取內容會被取代，擷取會停止。"
          }
        }
      }
    },
    "删除后无法恢复。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This can't be undone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除後無法復原。"
          }
        }
      }
    },
    "无法读取（密钥不符或文件损坏）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't be read (wrong key or damaged file)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取（金鑰不符或檔案損毀）"
          }
        }
      }
    },
    "会话用只保存在本机钥匙串里的密钥加密，保留 7 天后自动删除。打开会话会替换当前的抓包内容并停止抓包，之后可以照常查看、筛选和导出。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessions are encrypted with a key kept only in this device's keychain and are deleted automatically after 7 days. Opening a session replaces the current capture and stops capturing; you can then view, filter and export it as usual."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作階段用只保存在本機鑰匙圈裡的金鑰加密，保留 7 天後自動刪除。開啟工作階段會取代目前的擷取內容並停止擷取，之後可以照常檢視、篩選和匯出。"
          }
        }
      }
    },
    "连接后可以查看和打开已保存的会话。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to view and open saved sessions."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線後可以檢視和開啟已儲存的工作階段。"
          }
        }
      }
    },
    "这台设备上无法保存会话（钥匙串不可用）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessions can't be saved on this device (the keychain is unavailable)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台裝置上無法儲存工作階段（鑰匙圈無法使用）。"
          }
        }
      }
    },
    "还没有保存的会话。在请求列表右上角“更多”中保存当前抓包。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No saved sessions yet. Save the current capture from “More” at the top right of the request list."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有儲存的工作階段。在請求列表右上角「更多」中儲存目前擷取。"
          }
        }
      }
    },
    "无法打开这个会话": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't open this session"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟這個工作階段"
          }
        }
      }
    },
    "无法删除这个会话": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't delete this session"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法刪除這個工作階段"
          }
        }
      }
    },
    "这个请求已被更新的抓包挤出（抓包内存有上限），或抓包已清空。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This request was pushed out by newer captures (capture memory is limited), or the capture was cleared."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個請求已被較新的擷取擠出（擷取記憶體有上限），或擷取已清空。"
          }
        }
      }
    },
    "等待消息…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for messages…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待訊息…"
          }
        }
      }
    },
    "没有消息": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No messages"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有訊息"
          }
        }
      }
    },
    "只读查看：消息原样转发，不能改写。每个请求保留最近 512 条、每条前 4 KiB。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only: messages are forwarded as they are and can't be rewritten. Each request keeps the latest 512 messages, the first 4 KiB of each."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "唯讀檢視：訊息原樣轉發，不能改寫。每個請求保留最近 512 則、每則前 4 KiB。"
          }
        }
      }
    },
    "事件原样逐条转发给 App。每个请求保留最近 512 条、每条前 4 KiB。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Events are forwarded to the app one by one as they are. Each request keeps the latest 512, the first 4 KiB of each."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "事件原樣逐條轉發給 App。每個請求保留最近 512 則、每則前 4 KiB。"
          }
        }
      }
    },
    "WebSocket 消息": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WebSocket Messages"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "WebSocket 訊息"
          }
        }
      }
    },
    "App 发出": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent by the app"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 送出"
          }
        }
      }
    },
    "收到": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Received"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收到"
          }
        }
      }
    },
    "拷贝": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拷貝"
          }
        }
      }
    },
    "压缩消息未能解压": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A compressed message couldn't be decompressed"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "壓縮訊息未能解壓縮"
          }
        }
      }
    },
    "链路": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鏈路"
          }
        }
      }
    },
    "AnixOps ↔ 服务器": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AnixOps ↔ Server"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AnixOps ↔ 伺服器"
          }
        }
      }
    },
    "只看 RST_STREAM、GOAWAY 和错误": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only RST_STREAM, GOAWAY and Errors"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只看 RST_STREAM、GOAWAY 和錯誤"
          }
        }
      }
    },
    "只记帧头（类型、标志、流、长度）和错误码、窗口增量等，不保存帧内容。每个连接保留最近 512 帧。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only frame headers (type, flags, stream, length) and values such as error codes and window increments are recorded, never frame contents. Each connection keeps the latest 512 frames."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只記錄訊框標頭（類型、旗標、串流、長度）和錯誤碼、視窗增量等，不儲存訊框內容。每個連線保留最近 512 個訊框。"
          }
        }
      }
    },
    "HTTP/2 帧": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP/2 Frames"
          }
