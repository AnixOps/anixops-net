    "导入": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入"
          }
        }
      }
    },
    "导入你的订阅，就能按规则把需要的流量走代理，其余直连。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import your subscription to send the traffic you choose through a proxy by rules, and everything else direct."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入你的訂閱，就能按規則把需要的流量走代理，其餘直連。"
          }
        }
      }
    },
    "导入失败": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import failed"
          }
        },
        "zh-Hant": {
