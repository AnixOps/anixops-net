          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯…"
          }
        }
      }
    },
    "复制分享链接": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy share link"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製分享連結"
          }
        }
      }
    },
    "已复制分享链接。链接里含有节点密码，只分享给信任的人。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share link copied. It contains the node password, so share it only with people you trust."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已複製分享連結。連結裡含有節點密碼，只分享給信任的人。"
          }
        }
      }
    },
    "保存失败": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存失敗"
          }
        }
      }
    },
    "密码、密钥和传输设置保持导入时的值。订阅更新后会恢复为订阅里的节点。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwords, keys and transport settings keep their imported values. A subscription update restores the provider's nodes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "密碼、金鑰和傳輸設定保持匯入時的值。訂閱更新後會恢復為訂閱裡的節點。"
          }
        }
      }
    },
    "请填写服务器地址": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a server address"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請填寫伺服器位址"
          }
        }
      }
    },
    "服务器地址不能包含空格或 /": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server address can't contain spaces or /"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器位址不能包含空格或 /"
          }
        }
      }
    },
    "端口应为 1–65535": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The port must be 1–65535"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接埠應為 1–65535"
          }
        }
      }
    },
    "站点标识是本机按主机名生成的字母，不联网取图标。HTTPS、QUIC 等标签按端口推断。上传、下载为该连接经隧道的字节数。目标域名来自请求本身或 TLS SNI / HTTP Host，只保存在内存里，下次连接或退出 App 时清空。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Site badges are letters made on this device from the host name; no icons are fetched. Tags such as HTTPS and QUIC are inferred from the port. Upload and download are the bytes each connection moved through the tunnel. Target names come from the request itself or its TLS SNI / HTTP Host, are kept only in memory and are cleared on the next connection or when the app quits."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "站點標識是本機按主機名產生的字母，不聯網取圖示。HTTPS、QUIC 等標籤按連接埠推斷。上傳、下載為該連線經隧道的位元組數。目標網域來自請求本身或 TLS SNI / HTTP Host，只儲存在記憶體裡，下次連線或結束 App 時清空。"
          }
        }
      }
    },
    "上次连接": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last session"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上次連線"
          }
        }
      }
    },
    "时长 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duration %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "時長 %@"
          }
        }
      }
    },
    "隧道已断开，显示断开前的记录": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnected. Showing requests from before the tunnel stopped."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隧道已斷開，顯示斷開前的記錄"
          }
        }
