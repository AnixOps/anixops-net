          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解密 %@"
          }
        }
      }
    },
    "%lld 个连接 · %@ · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld connections · %2$@ · %3$@"
          }
        },
