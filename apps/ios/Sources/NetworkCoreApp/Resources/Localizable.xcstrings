            "value": "No data for %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少 %@ 的資料"
          }
        }
      }
    },
    "这条规则现在不会匹配任何连接。": {
      "localizations": {
