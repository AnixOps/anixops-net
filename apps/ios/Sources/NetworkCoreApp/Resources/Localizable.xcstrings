            "value": "已儲存"
          }
        }
      }
    },
    "没有错误": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No errors"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有錯誤"
          }
        }
      }
    },
    "一行一条，兼容常见规则语法：类型,值,策略[,no-resolve]。策略为 DIRECT、REJECT 或代理名称；以 # 开头表示停用。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One rule per line, in common rule syntax: type,value,policy[,no-resolve]. Policy is DIRECT, REJECT or a proxy name; a leading # switches the rule off."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一行一條，相容常見規則語法：類型,值,策略[,no-resolve]。策略為 DIRECT、REJECT 或代理名稱；以 # 開頭表示停用。"
          }
        }
      }
    },
    "第 %lld 行": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Line %lld"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %lld 行"
          }
        }
      }
    },
    "%lld 处错误，改好后才能保存": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld errors; fix them to save"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 處錯誤，改好後才能儲存"
          }
        }
      }
    },
    "不支持的规则类型 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsupported rule type %@"
          }
