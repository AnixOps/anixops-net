          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在終端機用 anixops 查看狀態、連線、切換節點、測速和匯入。在終端機執行下面的命令後即可使用："
          }
        }
      }
    },
    "复制": {
      "localizations": {
