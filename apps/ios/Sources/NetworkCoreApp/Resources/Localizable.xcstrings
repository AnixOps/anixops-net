      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unexpected HTTP status"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP 狀態異常"
          }
        }
      }
