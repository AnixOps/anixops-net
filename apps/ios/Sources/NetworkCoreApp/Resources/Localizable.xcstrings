          "stringUnit": {
            "state": "translated",
            "value": "Saved encrypted: %@, deleted automatically after 7 days"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已加密儲存：%@，7 天後自動刪除"
          }
        }
      }
    },
    "打开会话“%@”？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open session “%@”?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟工作階段「%@」？"
          }
        }
      }
    },
    "删除会话“%@”？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete session “%@”?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除工作階段「%@」？"
          }
        }
      }
    },
    "%@ 自动删除": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted automatically on %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 自動刪除"
          }
        }
      }
    },
    "共 %llu 条": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%llu in total"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
