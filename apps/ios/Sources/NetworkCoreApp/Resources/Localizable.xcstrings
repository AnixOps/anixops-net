            "state": "translated",
            "value": "儲存目前擷取"
          }
        }
      }
    },
    "图片": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片"
          }
        }
      }
    },
    "非 GET": {
      "localizations": {
