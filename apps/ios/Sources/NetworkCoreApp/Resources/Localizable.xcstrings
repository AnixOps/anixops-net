            "state": "translated",
            "value": "Go to Page %lld"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前往第 %lld 頁"
          }
        }
      }
    },
    "请求头“%@”格式不对，每行写“名称: 值”。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request header “%@” is malformed. Write one per line as “Name: value”."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求標頭「%@」格式不對，每行寫「名稱: 值」。"
          }
        }
      }
    },
    "代理模式：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy mode: %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理模式：%@"
          }
        }
      }
    },
    "接管方式：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Takeover: %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接管方式：%@"
          }
        }
      }
    },
    "无法把证书加入钥匙串（OSStatus %d），请用“钥匙串访问”手动信任。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not add the certificate to the keychain (OSStatus %d). Trust it manually in Keychain Access."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法把憑證加入鑰匙圈（OSStatus %d），請用「鑰匙圈存取」手動信任。"
          }
        }
      }
    },
    "无法设置信任（OSStatus %d），请用“钥匙串访问”手动信任。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not set trust (OSStatus %d). Trust it manually in Keychain Access."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法設定信任（OSStatus %d），請用「鑰匙圈存取」手動信任。"
          }
        }
      }
    },
    "设置页提供 iPhone 和 Android 的步骤及根证书下载。设好代理后，在手机上打开 http://%@ 检查。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The setup page has the steps for iPhone and Android and the root certificate download. After setting the proxy, open http://%@ on the phone to check."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定頁提供 iPhone 和 Android 的步驟及根憑證下載。設好代理後，在手機上開啟 http://%@ 檢查。"
          }
        }
      }
    },
    "%llu 条手机连接": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%llu phone connections"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%llu 條手機連線"
          }
        }
      }
    },
    "流量仅在本机按规则转发到所配置的服务器，开发者无法查看也不收集。App 不含统计、广告或崩溃上报 SDK，数据只保存在本机。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Traffic is forwarded on this device to the configured servers by the rules; the developer cannot see or collect it. The app has no analytics, advertising or crash-reporting SDK, and data stays on this device."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "流量僅在本機按規則轉發到所設定的伺服器，開發者無法檢視也不收集。App 不含統計、廣告或當機回報 SDK，資料只儲存在本機。"
          }
        }
      }
    },
    "阅读隐私政策": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the Privacy Policy"
          }
        },
        "zh-Hant": {
