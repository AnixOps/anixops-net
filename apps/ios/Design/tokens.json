  "radius": { "control": 8, "chip": 10, "card": 16, "hero": 24 },
  "radiusDesktop": { "control": 6, "chip": 8, "card": 10, "hero": 14 },
  "spacing": { "xxs": 4, "xs": 8, "sm": 12, "md": 16, "lg": 24, "xl": 32, "xxl": 48 },
  "motion": {
    "microMs": 120,
    "standardMs": 220,
    "emphasisMs": 360,
    "connectDrawMs": 1200,
    "spring": { "response": 0.35, "dampingFraction": 0.85 }
