{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "导出日志…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export Logs…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出日誌…"
          }
        }
      }
    },
    "导出日志": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export Logs"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出日誌"
          }
        }
      }
    },
    "日志导出失败": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not export logs"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "日誌匯出失敗"
          }
        }
      }
    },
    "诊断": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "診斷"
          }
        }
      }
    },
    "将诊断信息保存为 .log 文件，经系统分享发送；地址、网址、账号和密钥已去除。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves diagnostics as a .log file to share via the system share sheet; addresses, URLs, accounts and keys are removed."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將診斷資訊儲存為 .log 檔，經系統分享傳送；位址、網址、帳號和金鑰已去除。"
          }
        }
      }
    },
    " · 已暂停刷新": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · paused"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " · 已暫停重新整理"
          }
        }
      }
    },
