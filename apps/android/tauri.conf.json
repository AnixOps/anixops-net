{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnixOps Net",
  "version": "0.3.0",
  "identifier": "io.anixops.net.android",
  "build": {
    "frontendDist": "../windows-gui/ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AnixOps Net"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/networkcore.png"
    ],
    "android": {
      "minSdkVersion": 26
    }
  }
}
