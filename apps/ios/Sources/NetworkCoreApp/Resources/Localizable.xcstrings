          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "失敗原因"
          }
        }
      }
    },
    "峰值速度": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Peak speed"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "峰值速度"
          }
        }
