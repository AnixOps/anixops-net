<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="AnixOps NetworkCore"
      Manufacturer="AnixOps"
      Version="$(ProductVersion)"
      UpgradeCode="8B5A5235-4D18-4AD5-9C64-37A29C6E2D1C"
      Scope="perMachine"
      InstallerVersion="500"
      Compressed="yes">
    <SummaryInformation Description="AnixOps NetworkCore managed Windows client" />
    <!--
      The earlier version is removed only after this one is installed (afterInstallExecute): files
      and components that both versions share keep their reference, so managed-config.json, which
      the client rewrites at runtime, is kept as the user left it. That needs every component to keep
      its identity (Id, folder, file name, key path) from one version to the next, and every
      versioned file to carry a higher file version in each release (release.yml stamps the MSI
      version into the GUI executable and checks it).
    -->
    <MajorUpgrade
        Schedule="afterInstallExecute"
        DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <!--
      The app icon (AnixOps Design's AnixOps Net icon, copied by .github/scripts/sync_design.py). An advertised
      shortcut does not take the icon of the program it opens: without Icon it shows the blank file icon in the
      Start menu and in search. ARPPRODUCTICON is the icon of the entry in Installed apps.
      .github/scripts/windows_icons.py checks both here and in the built MSI.
    -->
    <Icon Id="AnixOpsNet.ico" SourceFile="$(sys.SOURCEFILEDIR)..\..\apps\windows-gui\icons\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AnixOpsNet.ico" />

    <!--
      Where an earlier version was installed, so that an upgrade installs over it: with the removal
      after the installation, a different folder would leave the earlier files behind.
    -->
    <Property Id="INSTALLFOLDER" Secure="yes">
      <RegistrySearch
          Id="RememberedInstallFolder"
          Root="HKLM"
          Key="Software\AnixOps\NetworkCore"
          Name="InstallFolder"
          Type="raw"
          Bitness="always64" />
    </Property>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="ManufacturerFolder" Name="AnixOps">
        <Directory Id="INSTALLFOLDER" Name="NetworkCore">
          <Component Id="GuiComponent" Guid="*">
            <File
                Id="GuiExe"
                Source="$(GuiExe)"
                Name="networkcore-windows-gui.exe"
                KeyPath="yes">
              <Shortcut
                  Id="NetworkCoreStartMenuShortcut"
                  Directory="ProgramMenuFolder"
                  Name="AnixOps NetworkCore"
                  Description="Open the NetworkCore Windows client"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AnixOpsNet.ico"
                  Advertise="yes" />
            </File>
          </Component>

          <Component Id="WebView2LoaderComponent" Guid="*">
            <File
                Id="WebView2LoaderDll"
                Source="$(WebView2LoaderDll)"
                Name="WebView2Loader.dll"
                KeyPath="yes" />
          </Component>

          <Component Id="WintunComponent" Guid="*">
            <File
                Id="WintunDll"
                Source="$(WintunDll)"
                Name="wintun.dll"
                KeyPath="yes" />
          </Component>

          <!--
            License notices: the client's own license, the third-party notices (release.yml generates them from the
            package managers' metadata, .github/scripts/third_party_notices.py) and Wintun's license, which its terms
            ask to keep beside wintun.dll.
          -->
          <Component Id="LicenseComponent" Guid="*">
            <File
                Id="LicenseText"
                Source="$(LicenseFile)"
                Name="LICENSE.txt"
                KeyPath="yes" />
          </Component>

          <Component Id="ThirdPartyNoticesComponent" Guid="*">
            <File
                Id="ThirdPartyNotices"
                Source="$(NoticesFile)"
                Name="THIRD_PARTY_NOTICES.txt"
                KeyPath="yes" />
          </Component>

          <Component Id="WintunLicenseComponent" Guid="*">
            <File
                Id="WintunLicense"
                Source="$(WintunLicense)"
                Name="wintun-LICENSE.txt"
                KeyPath="yes" />
          </Component>

          <!-- The install integrity list the client checks at start (crates/client-health). -->
          <Component Id="IntegrityListComponent" Guid="*">
            <File
                Id="IntegrityList"
                Source="$(IntegrityList)"
                Name="integrity.sha256"
                KeyPath="yes" />
          </Component>

          <Component Id="InstallFolderRegistryComponent" Guid="*">
            <RegistryValue
                Root="HKLM"
                Key="Software\AnixOps\NetworkCore"
                Name="InstallFolder"
                Type="string"
                Value="[INSTALLFOLDER]"
                KeyPath="yes" />
          </Component>

          <!--
            The anixops:// handler (apps/windows-link). It has no administrator manifest, so a link opened while
            the client runs reaches it without an administrator prompt; the client registers it for each user
            when it starts.
          -->
          <Component Id="LinkHandlerComponent" Guid="*">
            <File
                Id="LinkHandlerExe"
                Source="$(LinkExe)"
                Name="anixops-net-link.exe"
                KeyPath="yes" />
          </Component>

          <Component Id="CliComponent" Guid="*">
            <File
                Id="CliExe"
                Source="$(CliExe)"
                Name="networkcore-windows.exe"
                KeyPath="yes" />
          </Component>

        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="ProgramDataManufacturerFolder" Name="AnixOps">
        <Directory Id="MANAGEDDATADIR" Name="NetworkCore">
          <!--
            The data folder holds subscriptions, node credentials and keys: only the system and
            administrators may open it. The client also closes it, and takes back what earlier
            versions left in it open to all users, each time it starts
            (crates/windows-data, close_with_contents).
          -->
          <Component Id="ManagedDataFolderComponent" Guid="8DA5618D-CE64-4C14-AD11-F06D2F7BB2A5" KeyPath="yes">
            <CreateFolder>
              <PermissionEx Sddl="D:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" />
            </CreateFolder>
          </Component>
          <Component Id="ManagedConfigurationComponent" Guid="*" NeverOverwrite="yes">
            <File
                Id="DefaultManagedConfiguration"
                Source="$(DefaultConfig)"
                Name="managed-config.json"
                KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="Complete" Title="AnixOps NetworkCore" Level="1">
      <ComponentRef Id="GuiComponent" />
      <ComponentRef Id="WebView2LoaderComponent" />
      <ComponentRef Id="WintunComponent" />
      <ComponentRef Id="CliComponent" />
      <ComponentRef Id="LinkHandlerComponent" />
      <ComponentRef Id="IntegrityListComponent" />
      <ComponentRef Id="LicenseComponent" />
      <ComponentRef Id="ThirdPartyNoticesComponent" />
      <ComponentRef Id="WintunLicenseComponent" />
      <ComponentRef Id="ManagedConfigurationComponent" />
      <ComponentRef Id="ManagedDataFolderComponent" />
      <ComponentRef Id="InstallFolderRegistryComponent" />
    </Feature>

    <CustomAction
        Id="PurgeManagedNetworkState"
        FileRef="GuiExe"
        ExeCommand="--purge"
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />
    <CustomAction
        Id="CleanupCurrentUserStartup"
        FileRef="GuiExe"
        ExeCommand="--cleanup-startup"
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />
    <!--
      During an upgrade the earlier version's uninstall actions run this version's program, and
      before 1.0 they did not tell an upgrade from a removal. This version notes the upgrade while it
      installs its files, before the earlier version is removed, and clears the note afterwards
      (main.rs, removal_is_an_upgrade).
    -->
    <CustomAction
        Id="NoteUpgrade"
        FileRef="GuiExe"
        ExeCommand="--note-upgrade"
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />
    <CustomAction
        Id="ClearUpgradeNote"
        FileRef="GuiExe"
        ExeCommand="--clear-upgrade-note"
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />
    <!--
      Only on a full removal: an upgrade keeps the users' sign-in startup tasks, the decryption roots
      they trusted and the key. The packages before 1.0 lack the UPGRADINGPRODUCTCODE test; when they
      are upgraded their actions run this version's program, which tells an upgrade apart itself
      (main.rs, removal_is_an_upgrade).
    -->
    <InstallExecuteSequence>
      <Custom
          Action="NoteUpgrade"
          After="InstallFiles"
          Condition="WIX_UPGRADE_DETECTED AND NOT REMOVE=&quot;ALL&quot;" />
      <Custom
          Action="ClearUpgradeNote"
          After="RemoveExistingProducts"
          Condition="WIX_UPGRADE_DETECTED AND NOT REMOVE=&quot;ALL&quot;" />
      <Custom
          Action="PurgeManagedNetworkState"
          Before="RemoveFiles"
          Condition="Installed AND REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom
          Action="CleanupCurrentUserStartup"
          Before="RemoveFiles"
          Condition="Installed AND REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
