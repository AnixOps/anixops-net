        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存對應"
          }
        }
      }
    },
    "抓 HTTPS 请求前还差 %lld 步": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld steps left before HTTPS requests are captured"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擷取 HTTPS 請求前還差 %lld 步"
          }
        }
      }
    },
    "明文 HTTP 请求无需上述步骤，开始抓包后列出。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plain HTTP requests need no steps; they are listed once capture starts."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "明文 HTTP 請求無需上述步驟，開始擷取後列出。"
          }
        }
      }
    },
    "信任根证书": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trust the root certificate"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "信任根憑證"
          }
        }
      }
    },
    "添加要解密的域名": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add domains to decrypt"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增要解密的網域"
          }
        }
      }
    },
    "开始抓包": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Capture"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始擷取"
          }
        }
      }
    },
    "用连接开关连接。调试模式默认直连，不需要节点。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on the connection switch. Debug mode connects directly by default; no node is needed."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用連線開關連線。偵錯模式預設直連，不需要節點。"
          }
        }
      }
    },
    "在 改写 › HTTPS 解密证书 生成并信任，只需一次。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generate and trust it once in Rewrite › HTTPS Decryption Certificate."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 改寫 › HTTPS 解密憑證 產生並信任，只需一次。"
          }
        }
      }
    },
    "在 改写 › 解密域名 添加，或在加密连接的详情里点“解密此域名”。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add them in Rewrite › Decrypted Domains, or tap “Decrypt This Domain” in an encrypted connection's details."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 改寫 › 解密網域 新增，或在加密連線的詳情裡點「解密此網域」。"
          }
        }
      }
    },
    "开始后，新的请求会逐条出现在这里。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New requests appear here one by one once it starts."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始後，新的請求會逐條出現在這裡。"
          }
        }
      }
    },
    "解密此域名": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decrypt This Domain"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解密此網域"
          }
        }
      }
    },
    "这是加密的 TLS 数据。目标是 IP 地址，没有域名可以解密。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is encrypted TLS data. The target is an IP address, so there is no domain to decrypt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是加密的 TLS 資料。目標是 IP 位址，沒有網域可以解密。"
          }
        }
      }
    },
    "这是加密的 TLS 数据。该域名已在解密列表中，新连接将被解密（需已信任 HTTPS 解密证书）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is encrypted TLS data. The domain is on the decrypt list; new connections are decrypted (the HTTPS decryption certificate must be trusted)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是加密的 TLS 資料。該網域已在解密清單中，新連線將被解密（需已信任 HTTPS 解密憑證）。"
          }
        }
      }
    },
    "这是加密的 TLS 数据。点“解密此域名”后，新的连接会被解密（需要先信任 HTTPS 解密证书）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is encrypted TLS data. After tapping “Decrypt This Domain”, new connections are decrypted (the HTTPS decryption certificate must be trusted first)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是加密的 TLS 資料。點「解密此網域」後，新的連線會被解密（需要先信任 HTTPS 解密憑證）。"
          }
        }
      }
    },
    "暂无请求": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No requests"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫無請求"
          }
        }
