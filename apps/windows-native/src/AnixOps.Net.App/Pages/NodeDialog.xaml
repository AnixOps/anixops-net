<ContentDialog
    x:Class="AnixOps.Net.App.Pages.NodeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Closing="OnClosing"
    Style="{StaticResource DefaultContentDialogStyle}">

    <!-- One node: its name, server and port, which can be changed for a node of the subscription in use, the
         button that removes it, and its share link with a QR code. The removal is asked about in this same
         dialog, in place of the node (Windows shows one dialog at a time). What stands here is decided in
         AnixOps.Net.Presentation.Node; this draws it. -->
    <Grid Width="440">
        <ScrollViewer
            x:Name="Form"
            MaxHeight="520"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="0,0,16,0" Spacing="12">
                <TextBlock
                    x:Name="ProtocolText"
                    AutomationProperties.AutomationId="Node.Protocol"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis" />
                <TextBox
                    x:Name="NameBox"
                    AutomationProperties.AutomationId="Node.Name"
                    IsSpellCheckEnabled="False"
                    KeyDown="OnBoxKeyDown"
                    MaxLength="200" />
                <TextBox
                    x:Name="ServerBox"
                    AutomationProperties.AutomationId="Node.Server"
                    InputScope="Url"
                    IsSpellCheckEnabled="False"
                    KeyDown="OnBoxKeyDown"
                    MaxLength="255" />
                <TextBox
                    x:Name="PortBox"
                    AutomationProperties.AutomationId="Node.Port"
                    InputScope="Number"
                    IsSpellCheckEnabled="False"
                    KeyDown="OnBoxKeyDown"
                    MaxLength="5" />
                <TextBlock
                    x:Name="NoteText"
                    AutomationProperties.AutomationId="Node.Note"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
                <!-- Selectable, so that the reason can be copied into a message asking for help. -->
                <TextBlock
                    x:Name="ProblemText"
                    AutomationProperties.AutomationId="Node.Problem"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="KeepText"
                    AutomationProperties.AutomationId="Node.Keep"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <StackPanel
                    x:Name="Buttons"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="RemoveButton"
                        MinWidth="96"
                        AutomationProperties.AutomationId="Node.Remove"
                        Click="OnRemove" />
                    <Button
                        x:Name="SaveButton"
                        MinWidth="96"
                        AutomationProperties.AutomationId="Node.Save"
                        Click="OnSave"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>

                <TextBlock
                    x:Name="ShareHeading"
                    Margin="0,8,0,0"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    x:Name="NoLinkText"
                    AutomationProperties.AutomationId="Node.NoLink"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <!-- The code keeps its white ground in the dark theme too: that is what a camera reads. -->
                <Image
                    x:Name="QrImage"
                    Width="200"
                    Height="200"
                    HorizontalAlignment="Center"
                    AutomationProperties.AccessibilityView="Content"
                    AutomationProperties.AutomationId="Node.Qr"
                    Stretch="Uniform"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="LinkText"
                    AutomationProperties.AutomationId="Node.Link"
                    FontFamily="Consolas"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <Button
                    x:Name="CopyButton"
                    MinWidth="96"
                    HorizontalAlignment="Right"
                    AutomationProperties.AutomationId="Node.Copy"
                    Click="OnCopy"
                    Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <!-- The question asked before a removal. -->
        <StackPanel
            x:Name="Question"
            VerticalAlignment="Top"
            Spacing="16"
            Visibility="Collapsed">
            <TextBlock
                x:Name="QuestionText"
                AutomationProperties.AutomationId="Node.Question"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="QuestionNote"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="ConfirmButton"
                    MinWidth="96"
                    AutomationProperties.AutomationId="Node.Confirm"
                    Click="OnConfirm" />
                <Button
                    x:Name="CancelButton"
                    MinWidth="96"
                    AutomationProperties.AutomationId="Node.Cancel"
                    Click="OnCancel" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ContentDialog>
