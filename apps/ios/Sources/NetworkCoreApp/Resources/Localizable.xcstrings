            "state": "translated",
            "value": "未解密，只抓到加密資料"
          }
        }
      }
    },
    "所有抓到的连接都解密出了请求。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every captured connection was decrypted into requests."
          }
        },
