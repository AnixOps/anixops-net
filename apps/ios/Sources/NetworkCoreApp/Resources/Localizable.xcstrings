          }
        }
      }
    },
    "已保存的会话": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved Sessions"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的工作階段"
          }
        }
      }
    },
    "%lld 个域名，%lld 个排除": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld domains, %2$lld excluded"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 個網域，%2$lld 個排除"
          }
        }
      }
    },
    "* 匹配任意字符（含点），? 匹配一个字符；*.example.com 匹配所有子域名，不含 example.com 本身。排除的域名永不解密，优先于其他解密规则。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "* matches any characters (dots included), ? one character; *.example.com matches every subdomain but not example.com itself. Excluded domains are never decrypted and take precedence over all decryption rules."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "* 符合任意字元（含點），? 符合一個字元；*.example.com 符合所有子網域，不含 example.com 本身。排除的網域永不解密，優先於其他解密規則。"
          }
        }
      }
    },
    "排除": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclude"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排除"
          }
        }
      }
    },
    "排除 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclude %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排除 %@"
          }
        }
      }
    },
    "已排除": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluded"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
